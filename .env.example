# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# These are PUBLIC_ on purpose: the Maps JavaScript SDK runs in the browser,
# so the key is inlined into the built output and is visible to anyone who
# views source. That is Google's intended model for this API and cannot be
# avoided (there is no server hop to hide it behind).
#
# The key is therefore NOT protected by secrecy. It is protected by:
#   1. A daily quota cap of ~300 map loads (300 x 31 = 9,300, under the
#      10,000/month free tier — so abuse cannot generate a bill)
#   2. API restriction: Maps JavaScript API only, so a stolen key cannot
#      reach the expensive SKUs (Geocoding, Places, Directions)
#   3. HTTP referrer restrictions — a speed bump against casual copy-paste,
#      NOT a security boundary (the Referer header is client-supplied)
#
# Use a SEPARATE key locally vs in production. The production key allows only
# https://japantrip2026.io/*; the dev key allows only http://localhost:*.
# Never add localhost to the production key — it is the one published in the
# HTML, so anyone could spoof a localhost referer and use it.

# Dev key: referrer-restricted to http://localhost:4321/*, :4322, :4323
PUBLIC_GOOGLE_MAPS_API_KEY=

# Map ID from Cloud Console > Map Management. Required even with no custom
# style, because advanced markers need one. Not a credential — it is a public
# style pointer, safe to share.
PUBLIC_GOOGLE_MAPS_ID=
