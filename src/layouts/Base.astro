---
import { loadTrip } from '../lib/loadTrip';
import { TRIP_TITLE } from '../lib/trip';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = `Our ${TRIP_TITLE} trip itinerary`,
} = Astro.props;

// Derived from the segments' cityJa, so the font request can never disagree
// with the content. No Japanese city names yet → no font request at all.
const { kanjiSubset } = await loadTrip();
const jaFontHref =
  kanjiSubset.length > 0
    ? `https://fonts.googleapis.com/css2?family=Yuji+Syuku&display=swap&text=${encodeURIComponent(kanjiSubset)}`
    : null;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {/* The Japan flag, redrawn in the site's palette — paper field, accent-red
        sun, and a tan hairline so it doesn't vanish on a white tab bar. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* Unconditional now — the three text faces below are always requested, so
        the handshake is always worth warming. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* The site's three voices: EB Garamond sets the display serif, Caveat the
        handwriting, Karla the body. All three are variable on Google Fonts, so
        the weight lists below resolve to one file per family, not one per
        weight. Kept out of the Reggae One request because that one carries a
        text= subset and would drag these along into it. */}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Caveat:wght@400;600&family=Karla:wght@400;500;600;700;800&display=swap"
    />
    {/* Yuji Syuku, the fine-stroke brush face the city names are set in,
        subset via text= to exactly the glyphs the segments actually use — a
        couple of KB rather than a couple of hundred. Skipped entirely when no
        city has a cityJa. */}
    {jaFontHref && <link rel="stylesheet" href={jaFontHref} />}
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <slot />
    {/* Body-level so position: fixed overlays are never trapped by an
        ancestor's transform/filter containing block. */}
    <slot name="overlay" />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --paper: #f7f3ea;
    --paper-raised: #fffdf8;
    --ink: #1f1c17;
    --ink-muted: #6f6a5e;
    --border: #e4dccc;
    --highlight: #f2d36b;
    --accent: #c3423f;
    --radius: 10px;
    /* System stacks stay behind each webfont so display=swap's first paint
       lands on something with roughly the right shape. */
    --font: 'Karla', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --font-display: 'EB Garamond', 'Iowan Old Style', 'Palatino Linotype',
      'Book Antiqua', Georgia, serif;
    --font-hand: 'Caveat', 'Bradley Hand', 'Segoe Print', 'Comic Sans MS',
      cursive;
    --font-ja: 'Yuji Syuku', serif;
    /* Washi tape, the colour of the strips holding the photos down */
    --tape: rgb(233 212 150 / 0.92);
    --tape-ink: #3d3728;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background-color: var(--paper);
    /* Faint dot-grid paper texture */
    background-image: radial-gradient(
      circle,
      rgb(120 108 84 / 0.14) 1px,
      transparent 1.5px
    );
    background-size: 26px 26px;
    color: var(--ink);
    font-family: var(--font);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    font-weight: 400;
  }

  a {
    color: inherit;
    text-decoration-color: color-mix(in srgb, var(--accent) 55%, transparent);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  a:hover {
    color: var(--accent);
  }

  img {
    max-width: 100%;
    display: block;
  }

  /* --- Shared marks -------------------------------------------------------
     Global because they're the site's handwriting, not any one component's.
     A scoped rule compiles to `.x[data-astro-cid-…]` (0,2,0) and always beats
     these (0,1,0), so a component can still tune one locally — see the hero's
     .swash variant and the trimmed rules in Footer/404.

     This block is the single source for these names. Don't redefine them
     globally elsewhere; map-paper.css is the only other global sheet and it
     targets .mapslot* exclusively.
     ---------------------------------------------------------------------- */

  /* Handwritten margin notes, captions, and cues */
  .hand {
    font-family: var(--font-hand);
  }

  /* Marker-pen highlight blob. [data-size='lg'] is the hero's tuned variant:
     at 5rem type the small radii read as a rectangle, not a swipe of ink. */
  .swash {
    display: inline-block;
    padding: 0 0.4em;
    background: var(--highlight);
    border-radius: 0.6em 0.9em 0.7em 0.8em;
    rotate: -1.2deg;
  }

  .swash[data-size='lg'] {
    padding: 0 0.18em;
    border-radius: 0.45em 0.35em 0.5em 0.4em / 0.65em 0.5em 0.4em 0.55em;
  }

  /* A torn strip of washi tape. Section labels wear it, and so does the
     cover page's one button — which is why it lives here rather than in
     either component. `clip-path` gives the torn edge; [data-tilt='right']
     leans the other way so a column of them doesn't look rubber-stamped.

     clip-path clips box-shadow too, so the lift on hover is done with
     translate rather than a shadow. */
  .tape {
    display: inline-block;
    background: var(--tape);
    clip-path: polygon(2% 0, 100% 6%, 98% 100%, 0 94%);
    padding: 0.25rem 0.8rem;
    rotate: -1.2deg;
    font-weight: 800;
    font-size: 0.63rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tape-ink);
  }

  .tape[data-tilt='right'] {
    clip-path: polygon(0 6%, 98% 0, 100% 94%, 2% 100%);
    rotate: 1.2deg;
  }

  /* Leading emoji on a section tape. Decorative (always aria-hidden), sized
     up from the tape's tiny caps because an emoji at 0.63rem is a smudge,
     and pulled out of the letterspacing so the tracking doesn't gap it from
     its word. Sections wear icons; buttons (the cover CTA) don't. */
  .tape > .tape-icon {
    font-size: 1.45em;
    letter-spacing: normal;
    margin-right: 0.35em;
    vertical-align: -0.12em;
  }

  /* Neutral count chip — nights, pin counts. Deliberately not the highlighter:
     these are facts, not emphasis. */
  .pill {
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--paper-raised);
    padding: 0.1rem 0.5rem;
  }

  /* Bordered aside on the mobile paper sheet. No `display` on purpose — both
     users toggle their own at a breakpoint. */
  .note-strip {
    margin: 0 0 1.4rem;
    padding: 0.6rem 0.85rem;
    font-size: 0.9rem;
    color: var(--ink-muted);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--paper-raised);
  }

  /* Scroll-driven entry, opted into per element. Evergreen browsers only;
     older ones get a clean static layout. Astro does NOT scope @keyframes, so
     `rise` was already global by accident — this makes that deliberate before
     three components reference it. */
  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 1.2rem;
    }
  }

  @supports (animation-timeline: view()) {
    .rise-in {
      animation: rise linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 30%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rise-in {
      animation: none;
    }
  }

  /* Visually hidden, still announced */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
