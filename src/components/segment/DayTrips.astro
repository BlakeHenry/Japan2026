---
interface Props {
  trips?: { name: string; note?: string }[];
}

const { trips = [] } = Astro.props;
---

{/* Day trips out of this base. These are structure the trip chose — not
    bookings, not loose ideas — so they sit between Day by day and the idea
    chips: firmer than a maybe, looser than a reservation. A base with no
    day trips renders nothing at all; "none planned" is a settled state, so
    there's no empty state to speak (the one deliberate exception to the
    empty-states rule). */}
{
  trips.length > 0 && (
    <section class="daytrips">
      <span class="tape" data-tilt="left">Day trips</span>
      <ul class="trips">
        {trips.map((t) => (
          <li class="trip">
            <span class="trip-name">{t.name}</span>
            {t.note && <span class="trip-note hand">{t.note}</span>}
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .trips {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
  }

  /* The idea chips' paper-tag treatment, minus everything link-shaped: no
     hover lift, no ↗ — a day trip is a plan, not a place to tap through to. */
  .trip {
    display: inline-flex;
    align-items: baseline;
    gap: 0.55rem;
    background: var(--paper-raised);
    box-shadow: 0 3px 8px rgb(60 50 30 / 0.14);
    border-radius: 4px;
    padding: 0.45rem 0.85rem;
    rotate: -0.4deg;
  }

  .trip:nth-child(even) {
    rotate: 0.4deg;
  }

  .trip-name {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--ink);
  }

  .trip-note {
    font-size: 1.1rem;
    line-height: 1.1;
    color: var(--ink-muted);
  }
</style>
