---
import type { SegmentItinerary } from '../../lib/itinerary';
import { formatStay } from '../../lib/itinerary';
import SegmentShell from './SegmentShell.astro';
import CityPhoto from './CityPhoto.astro';
import StayCard from './StayCard.astro';
import TravelCard from './TravelCard.astro';
import DayByDay from './DayByDay.astro';
import IdeaChips from './IdeaChips.astro';

interface Props {
  si: SegmentItinerary;
  accent: string;
  index: number;
}

const { si, accent, index } = Astro.props;
const { segment, days, ideas } = si;
const { city, cityJa, start, end, lodging, arrive, depart, heroImage, heroAlt, tagline } =
  segment.data;

// `end` is the last full day and we leave the next morning, so the day count
// and the night count are the same number.
const nights = days.length;
const subline = `${formatStay(start, end)} · ${nights} ${nights === 1 ? 'night' : 'nights'}`;
const alt = index % 2 === 1;
---

<SegmentShell
  id={si.slug}
  title={city}
  titleJa={cityJa}
  subline={subline}
  accent={accent}
  alt={alt}
>
  <Fragment slot="stay">
    <CityPhoto image={heroImage} alt={heroAlt} caption={tagline} alt2={alt} />
    <StayCard city={city} lodging={lodging} />
    <TravelCard arrive={arrive} depart={depart} />
  </Fragment>

  <Fragment slot="plan">
    <DayByDay days={days} arrive={arrive} />
    <IdeaChips stops={ideas} city={city} />
  </Fragment>

  <div class="segment-notes" slot="notes">
    <slot />
  </div>
</SegmentShell>

<style>
  .segment-notes {
    max-width: 74rem;
    margin: 2rem auto 0;
    font-size: 0.92rem;
    color: var(--ink-muted);
  }

  .segment-notes :global(p) {
    margin: 0.4rem 0;
  }
</style>
