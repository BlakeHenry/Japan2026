---
interface Props {
  /** The section's `:target` id — always from citySlug() */
  id: string;
  title: string;
  titleJa?: string;
  /** The line under the title — a base's dates, a day trip's aside */
  subline?: string;
  accent: string;
  /** Drives the alternating background tint. A day-trip panel passes its
      parent's value so, in the no-:has() fallback where every section stacks
      on one page, a base and its day trips read as one tinted band. */
  alt: boolean;
  /** Marks a day-trip panel — a styling hook, not a behavior switch: the
      tab CSS keys off .segment either way. */
  daytrip?: boolean;
}

const { id, title, titleJa, subline, accent, alt, daytrip = false } =
  Astro.props;
---

{/* The header, then two columns: the place on the left (its photo), what we
    do with it on the right (anything booked, then the ideas). Both slots are
    plain flow — no sticky, no scroll-driven anything, so a city is one
    readable block whatever its height. The narrow left column is what holds
    the photo to postcard scale; given the whole panel it would fill the
    screen and push the ideas out of sight. */}
<section
  class:list={['segment', { daytrip }]}
  id={id}
  data-alt={alt}
  style={`--accent: ${accent}`}
>
  <div class="segment-inner">
    <slot name="badge" />
    <header class="segment-head">
      <h2 class="city">{title}</h2>
      {
        titleJa && (
          <span class="city-ja" lang="ja" aria-hidden="true">
            {titleJa}
          </span>
        )
      }
      {subline && <p class="stay">{subline}</p>}
    </header>

    <div class="segment-grid">
      <div class="col col-photo">
        <slot name="photo" />
      </div>
      <div class="col col-plan">
        <slot name="plan" />
      </div>
    </div>

    <slot name="notes" />
  </div>
</section>

<style>
  .segment {
    --seg-bg: var(--paper);
    /* No inline padding: the page frame already insets this, and a second
       inset would push the panel off the grid's left edge above it. */
    padding: 2.2rem 0 3.5rem;
    /* The panel sits inside a page frame that caps its own width, so viewport
       width says little about how much room these two columns actually have.
       Sizing against the section's own width is the whole point. Safe here
       only because this component owns no sticky pin or view-timeline —
       containment would have broken both. */
    container-type: inline-size;
  }

  /* With the tabs working, only one city shows at a time and this is just a
     gentle tint — but in the no-:has() fallback the cities stack on one
     long page again, and this is what keeps four of them from reading as
     one continuous sheet. That fallback is why it stays. */
  .segment[data-alt='true'] {
    --seg-bg: color-mix(in srgb, var(--paper-raised) 65%, var(--paper));
    background: var(--seg-bg);
  }

  /* Left-aligned, not centred: the panel opens directly under the grid, and
     the eye reads down the sheet's left edge — the label rail, every band's
     accent key, and now this. Centring it inside the wider page frame put a
     visible step between the band you clicked and the header that answers
     it. The cap still holds the columns to a readable width. */
  .segment-inner {
    max-width: 74rem;
  }

  /* The same tinted strip with an accent left key that this city wears in the
     grid above, at panel scale — so the band you clicked and the panel that
     opened read as the same object. The colour is the data here, which is
     also why the title drops the highlighter chip: two marks competing to
     say "this one" is one too many. */
  .segment-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0 0.9rem;
    margin-bottom: 2rem;
    padding: 0.55rem 0.9rem;
    background: color-mix(in srgb, var(--accent) 20%, var(--paper-raised));
    border-left: 3px solid var(--accent);
    border-radius: 3px;
  }

  .city {
    margin: 0;
    font-weight: 600;
    font-size: 1.75rem;
    line-height: 1.2;
  }

  .city-ja {
    font-family: var(--font-ja);
    font-weight: 400;
    font-size: 1.1rem;
    color: #8a7648;
  }

  .stay {
    margin: 0;
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .segment-grid {
    display: grid;
    grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
    gap: 2.6rem;
    align-items: start;
  }

  .col {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    min-width: 0;
  }

  .col-plan {
    gap: 2.4rem;
  }

  @container (max-width: 54rem) {
    .segment-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.2rem;
    }
  }

  @media (max-width: 900px) {
    .segment {
      padding: 1.8rem 0 3rem;
    }
  }
</style>
