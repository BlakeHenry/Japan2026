---
import type { SegmentItinerary } from '../../lib/itinerary';
import { citySlug, formatStay } from '../../lib/itinerary';

interface Props {
  si: SegmentItinerary;
  accent: string;
  /** Position in the trip — drives the alternating background */
  index: number;
}

const { si, accent, index } = Astro.props;
const { segment, days } = si;
const { city, start, end, cityJa } = segment.data;

const id = citySlug(city);
// `end` is the last full day and we leave the next morning, so the day count
// and the night count are the same number.
const nights = days.length;
const alt = index % 2 === 1;
---

{/* The city header, then two columns: the stay itself on the left (photo,
    lodging, how we get here), what we do with it on the right (day by day,
    ideas). Both slots are plain flow — no sticky, no scroll-driven anything,
    so a city is one readable block whatever its height. */}
<section class="segment" id={id} data-alt={alt} style={`--accent: ${accent}`}>
  <div class="segment-inner">
    <header class="segment-head">
      <h2 class="city"><span class="city-name">{city}</span></h2>
      {
        cityJa && (
          <span class="city-ja" lang="ja" aria-hidden="true">
            {cityJa}
          </span>
        )
      }
      <p class="stay">
        {`${formatStay(start, end)} · ${nights} ${nights === 1 ? 'night' : 'nights'}`}
      </p>
    </header>

    <div class="segment-grid">
      <div class="col col-stay">
        <slot name="stay" />
      </div>
      <div class="col col-plan">
        <slot name="plan" />
      </div>
    </div>

    <slot name="notes" />
  </div>
</section>

<style>
  .segment {
    --seg-bg: var(--paper);
    padding: 3.5rem 1.5rem 4rem;
    /* The route rail takes a fifth of the viewport out from under this, so a
       viewport media query would keep the two columns long after there's
       room for them. Sizing against the section's own width is the whole
       point. Safe here only because this component no longer owns a sticky
       pin or a view-timeline — containment would have broken both. */
    container-type: inline-size;
  }

  /* In the tabbed /plan/ only one city shows at a time and this is just a
     gentle tint — but in the no-:has() fallback the cities stack on one
     long page again, and this is what keeps four of them from reading as
     one continuous sheet. That fallback is why it stays. */
  .segment[data-alt='true'] {
    --seg-bg: color-mix(in srgb, var(--paper-raised) 65%, var(--paper));
    background: var(--seg-bg);
  }

  .segment-inner {
    max-width: 74rem;
    margin-inline: auto;
  }

  .segment-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0 1rem;
    margin-bottom: 2rem;
  }

  .city {
    margin: 0;
    font-weight: 500;
    font-size: clamp(2.4rem, 5vw, 3.5rem);
    line-height: 1.15;
  }

  /* The highlighter chip from the cover page's "2026", at city scale. Not
     .swash — that's the marker-pen blob, and this is the flat card. */
  .city-name {
    display: inline-block;
    background: var(--highlight);
    border-radius: 0.16em;
    padding: 0 0.24em;
  }

  .city-ja {
    font-family: var(--font-ja);
    font-weight: 400;
    font-size: clamp(1.3rem, 2.4vw, 1.8rem);
    color: #a89264;
  }

  .stay {
    margin: 0;
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .segment-grid {
    display: grid;
    grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
    gap: 2.6rem;
    align-items: start;
  }

  .col {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    min-width: 0;
  }

  .col-plan {
    gap: 2.4rem;
  }

  @container (max-width: 54rem) {
    .segment-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.2rem;
    }
  }

  @media (max-width: 900px) {
    .segment {
      padding: 2.5rem 1rem 3rem;
    }
  }
</style>
