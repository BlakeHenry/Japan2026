---
import { Image } from 'astro:assets';
import type { Stop } from '../../lib/itinerary';
import { googleMapsUrl, stopDomId } from '../../lib/itinerary';
import { CATEGORIES } from '../../lib/categories';

interface Props {
  stops: Stop[];
  city: string;
}

const { stops, city } = Astro.props;

const emojiFor = (key: string) =>
  CATEGORIES.find((c) => c.key === key)?.emoji ?? '📍';

// Same row-link priority the map pages use: coordinates beat a website,
// because on the day "where is it" beats "what are its hours".
const chips = stops.map((stop) => {
  const { title, category, lat, lng, link, image } = stop.data;
  const toMaps = lat != null && lng != null;
  return {
    id: stopDomId(stop.id),
    title,
    emoji: emojiFor(category),
    image,
    href: toMaps ? googleMapsUrl(lat!, lng!) : (link ?? null),
    toMaps,
    destination: toMaps ? 'Google Maps' : 'their website',
  };
});

// Only promise Maps when at least one chip actually opens it. A city whose
// stops have no coordinates links to websites instead, and the label has to
// say the truth about what tapping does.
const anyMaps = chips.some((c) => c.toMaps);
---

<section class="ideas">
  <span class="sheet-label">
    <span class="label-icon" aria-hidden="true">💡</span>Ideas{
      anyMaps && ' · tap to open Maps'
    }
  </span>
  {
    chips.length > 0 ? (
      <div class="chips">
        {chips.map((chip) =>
          chip.href ? (
            <a
              class="chip"
              id={chip.id}
              href={chip.href}
              target="_blank"
              rel="noopener"
            >
              {chip.image ? (
                <span class="chip-photo">
                  <Image
                    src={chip.image}
                    alt=""
                    widths={[96, 144]}
                    sizes="56px"
                    format="webp"
                    loading="lazy"
                    class="chip-img"
                  />
                </span>
              ) : (
                <span class="chip-photo chip-glyph" aria-hidden="true">
                  {chip.emoji}
                </span>
              )}
              {chip.title}
              <span class="go" aria-hidden="true">
                ↗
              </span>
              <span class="sr-only">(opens {chip.destination} in a new tab)</span>
            </a>
          ) : (
            <span class="chip" id={chip.id}>
              {chip.image ? (
                <span class="chip-photo">
                  <Image
                    src={chip.image}
                    alt=""
                    widths={[96, 144]}
                    sizes="56px"
                    format="webp"
                    loading="lazy"
                    class="chip-img"
                  />
                </span>
              ) : (
                <span class="chip-photo chip-glyph" aria-hidden="true">
                  {chip.emoji}
                </span>
              )}
              {chip.title}
            </span>
          )
        )}
      </div>
    ) : (
      <p class="empty">Nothing on the {city} list yet.</p>
    )
  }
</section>

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: 0.6rem;
    margin-top: 0.9rem;
  }

  /* Tiles rather than buttons — the whole chip is the target. Each leads with
     a small print (or a glyph tile for stops without a photo), so the left
     padding is tight to let the image sit flush in its frame. */
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    /* Anchors the sr-only "opens in a new tab" text. Unanchored it belongs to
       the page root, and its static position deep inside the scrolling panel
       becomes root overflow — enough that a #hash load scrolls the whole
       page and takes the grid off screen with it. Same fix as the overview
       grid's .leg. */
    position: relative;
    background: var(--paper-raised);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.3rem 0.8rem 0.3rem 0.3rem;
    font-size: 0.92rem;
    color: var(--ink);
    text-decoration: none;
    transition: background 0.15s ease;
  }

  a.chip:hover,
  a.chip:focus-visible {
    background: color-mix(in srgb, var(--highlight) 55%, var(--paper-raised));
    border-color: transparent;
    color: var(--ink);
  }

  /* The thumbnail, matted the way the city photo is framed. Doubles as the
     glyph tile when there's no photo. */
  .chip-photo {
    flex: none;
    width: 56px;
    height: 56px;
    background: var(--paper-raised);
    border: 1px solid var(--border);
    padding: 2px;
    border-radius: 2px;
  }

  .chip-photo :global(.chip-img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .chip-glyph {
    display: grid;
    place-items: center;
    font-size: 1.4rem;
    background: color-mix(in srgb, var(--highlight) 22%, var(--paper-raised));
  }

  .go {
    font-size: 0.72rem;
    color: var(--ink-muted);
  }

  .empty {
    margin: 0.9rem 0 0;
    font-size: 0.85rem;
    color: #b0a68f;
  }

  @media (prefers-reduced-motion: reduce) {
    .chip {
      transition: none;
    }
  }
</style>
