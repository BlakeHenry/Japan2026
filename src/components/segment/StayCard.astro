---
interface Props {
  city: string;
  lodging?: {
    name: string;
    area?: string;
    link?: string;
  };
}

const { city, lodging } = Astro.props;
---

{/* Always rendered, booked or not. Where we're sleeping is a fact of the
    stay, so a stay with nowhere booked should say so out loud rather than
    quietly drop the card and read as if it were settled. */}
<div class="card">
  <span class="sheet-label"
    ><span class="label-icon" aria-hidden="true">🏨</span>Staying at</span
  >
  {
    lodging ? (
      <Fragment>
        <p class="name">
          {lodging.link ? <a href={lodging.link}>{lodging.name}</a> : lodging.name}
        </p>
        {lodging.area && <p class="area">{lodging.area}</p>}
      </Fragment>
    ) : (
      <p class="empty">Nowhere booked in {city} yet.</p>
    )
  }
</div>

<style>
  .card {
    background: var(--paper-raised);
    box-shadow: 0 6px 16px rgb(60 50 30 / 0.12);
    border-radius: 3px;
    padding: 1.05rem 1.2rem 1.2rem;
  }

  .name {
    margin: 0.55rem 0 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    line-height: 1.25;
  }

  .name a {
    text-decoration-thickness: 1px;
  }

  .area {
    margin: 0.15rem 0 0;
    font-size: 0.85rem;
    color: var(--ink-muted);
  }

  .empty {
    margin: 0.55rem 0 0;
    font-size: 0.85rem;
    color: #b0a68f;
  }
</style>
