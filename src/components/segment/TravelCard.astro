---
import { travelEmoji, type TravelMode } from '../../lib/travel';

interface Leg {
  mode: TravelMode;
  text: string;
}

interface Props {
  arrive?: Leg[];
  depart?: Leg[];
  /** A base renders one bare list of how we get there ("Transportation"),
      plus a labelled "Heading home" block only when `depart` legs exist
      (the last city's flight out). A day trip passes "Getting there & back"
      with There/Back labels — `firstLabel` being set is what switches the
      card back to the two-half layout, so pass both labels or neither. */
  heading?: string;
  firstLabel?: string;
  secondLabel?: string;
}

const {
  arrive = [],
  depart = [],
  heading = 'Transportation',
  firstLabel,
  secondLabel = 'Heading home',
} = Astro.props;

const showSecond = firstLabel !== undefined || depart.length > 0;
---

{/* Legs are the pencilled route — an empty section means "nothing planned or
    booked yet" and says so; there's no third state to draw. The card itself
    always renders: every city is one we arrive in and leave, and hiding the
    whole thing would make an unplanned trip look like a settled one. */}
<div class="card">
  <span class="sheet-label"
    ><span class="label-icon" aria-hidden="true">🚄</span>{heading}</span
  >

  {firstLabel && <p class="leg-head">{firstLabel}</p>}
  {
    arrive.length > 0 ? (
      <ul class="legs">
        {arrive.map((l) => (
          <li>
            <span class="mode" aria-hidden="true">
              {travelEmoji(l.mode)}
            </span>
            <span>{l.text}</span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty">Nothing booked yet.</p>
    )
  }

  {
    showSecond && (
      <>
        <p class="leg-head">{secondLabel}</p>
        {depart.length > 0 ? (
          <ul class="legs">
            {depart.map((l) => (
              <li>
                <span class="mode" aria-hidden="true">
                  {travelEmoji(l.mode)}
                </span>
                <span>{l.text}</span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">Nothing booked yet.</p>
        )}
      </>
    )
  }
</div>

<style>
  .card {
    background: var(--paper-raised);
    box-shadow: 0 6px 16px rgb(60 50 30 / 0.12);
    border-radius: 3px;
    padding: 1.05rem 1.2rem 1.2rem;
  }

  .leg-head {
    margin: 0.9rem 0 0.2rem;
    font-weight: 700;
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #b0a68f;
  }

  /* With no first label the list (or empty note) directly follows the card's
     label, which used to get its breathing room from .leg-head's margin. */
  .sheet-label + .legs,
  .sheet-label + .empty {
    margin-top: 0.85rem;
  }

  .legs {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .legs li {
    display: flex;
    gap: 0.55rem;
    align-items: baseline;
    padding: 0.35rem 0;
    font-size: 0.88rem;
    line-height: 1.4;
    color: #4a443a;
    border-bottom: 1px dashed #e3dac2;
  }

  .legs li:last-child {
    border-bottom: 0;
  }

  .mode {
    flex: none;
    font-size: 0.95rem;
  }

  .empty {
    margin: 0.1rem 0 0;
    font-size: 0.85rem;
    color: #b0a68f;
  }
</style>
