---
import type { DayTripItinerary } from '../../lib/itinerary';
import { citySlug } from '../../lib/itinerary';
import SegmentShell from './SegmentShell.astro';
import CityPhoto from './CityPhoto.astro';
import IdeaChips from './IdeaChips.astro';

interface Props {
  dt: DayTripItinerary;
  parentCity: string;
  /** The parent segment's accent and tint — a day trip is part of its
      base's leg of the trip, and keeping both keeps the pair reading as one
      band in the no-:has() fallback stack. */
  accent: string;
  alt: boolean;
}

const { dt, parentCity, accent, alt } = Astro.props;
const { name, cityJa, note, heroImage, heroAlt, tagline } = dt.trip.data;
---

{/* The same frame a base city gets — photo, ideas, notes — plus the badge
    that says this one hangs off a base. Nothing is missing that a base has:
    a base's lodging and travel live on the grid above, and a day trip has
    neither. Its authored `there`/`back` legs stay in the file and render
    nowhere until the grid grows a row that can hold them. */}
<SegmentShell
  id={dt.slug}
  title={name}
  titleJa={cityJa}
  subline={note ?? 'Day trip'}
  accent={accent}
  alt={alt}
  daytrip
>
  {/* The badge is also the way back: one tap re-targets the parent's
      section, so it doubles as the panel's up-navigation. */}
  <a class="trip-badge" slot="badge" href={`#${citySlug(parentCity)}`}>
    <span aria-hidden="true">🎒</span> Day trip from {parentCity}
  </a>

  <Fragment slot="photo">
    <CityPhoto image={heroImage} alt={heroAlt} caption={tagline} />
  </Fragment>

  <Fragment slot="plan">
    <IdeaChips stops={dt.ideas} city={name} />
  </Fragment>

  <div class="segment-notes" slot="notes">
    <slot />
  </div>
</SegmentShell>

<style>
  /* The same dashed pill this trip wears in the grid above, where dashed
     means sub-location. Also the way back up: one tap re-targets the parent,
     so it has to read as tappable without reading as a button. */
  .trip-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 0.9rem;
    border: 1px dashed #b0a68f;
    border-radius: 4px;
    padding: 0.25rem 0.7rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ink-muted);
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .trip-badge:hover,
  .trip-badge:focus-visible {
    color: var(--ink);
    background: var(--highlight);
    border-color: transparent;
  }

  @media (prefers-reduced-motion: reduce) {
    .trip-badge {
      transition: none;
    }
  }

  .segment-notes {
    max-width: 74rem;
    margin: 2rem auto 0;
    font-size: 0.92rem;
    color: var(--ink-muted);
  }

  .segment-notes :global(p) {
    margin: 0.4rem 0;
  }
</style>
