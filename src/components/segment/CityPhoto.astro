---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  caption?: string;
  /** Alternating tilt so a column of cities doesn't look stamped */
  alt2?: boolean;
}

const { image, alt, caption, alt2 = false } = Astro.props;
---

<figure class="polaroid" data-alt={alt2}>
  <div class="polaroid-media">
    <Image
      src={image}
      alt={alt}
      widths={[480, 800, 1200]}
      sizes="(max-width: 900px) 92vw, 340px"
      format="webp"
      loading="lazy"
      class="polaroid-img"
    />
  </div>
  {caption && <figcaption class="hand">{caption}</figcaption>}
</figure>

<style>
  .polaroid {
    position: relative;
    margin: 0.6rem 0 0;
    background: #fff;
    padding: 0.7rem 0.7rem 0.5rem;
    box-shadow: 0 12px 28px rgb(60 50 30 / 0.16);
    rotate: -0.6deg;
  }

  .polaroid[data-alt='true'] {
    rotate: 0.6deg;
  }

  /* Two strips, same as the cover page's photo */
  .polaroid::before,
  .polaroid::after {
    content: '';
    position: absolute;
    top: -10px;
    width: 78px;
    height: 22px;
    background: rgb(233 212 150 / 0.85);
    box-shadow: 0 1px 3px rgb(60 50 30 / 0.15);
  }

  .polaroid::before {
    left: 34px;
    rotate: -3deg;
  }

  .polaroid::after {
    right: 34px;
    rotate: 3deg;
  }

  .polaroid-media {
    overflow: hidden;
    aspect-ratio: 16 / 10;
  }

  .polaroid :global(.polaroid-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  figcaption {
    margin-top: 0.5rem;
    text-align: center;
    font-size: 1.2rem;
    line-height: 1.25;
    color: #8a8172;
  }
</style>
