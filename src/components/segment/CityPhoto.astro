---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** No image renders the frame with a "no photo yet" note — a city can
      join the itinerary before anyone has a picture of it. */
  image?: ImageMetadata;
  alt?: string;
  caption?: string;
}

const { image, alt = '', caption } = Astro.props;
---

<figure class="photo">
  <div class="photo-media">
    {
      image ? (
        <Image
          src={image}
          alt={alt}
          widths={[480, 800, 1200]}
          sizes="(max-width: 900px) 92vw, 352px"
          format="webp"
          loading="lazy"
          class="photo-img"
        />
      ) : (
        <span class="photo-blank">No photo yet</span>
      )
    }
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  /* A mounted print, not a taped polaroid: the same paper-and-hairline frame
     the cards beside it use. The tape and the tilt belong to the cover. */
  .photo {
    margin: 0;
    background: var(--paper-raised);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 0.4rem;
  }

  .photo-media {
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border-radius: 2px;
  }

  .photo :global(.photo-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* An empty frame rather than no frame — the same "stated, not hidden"
     treatment the stay and travel cards give an unbooked leg. */
  .photo-blank {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    background: color-mix(in srgb, var(--paper) 70%, var(--paper-raised));
    font-size: 0.85rem;
    color: #b0a68f;
  }

  figcaption {
    margin-top: 0.45rem;
    text-align: center;
    font-size: 0.8rem;
    line-height: 1.35;
    color: var(--ink-muted);
  }
</style>
