---
import type { CollectionEntry } from 'astro:content';

interface Props {
  stop: CollectionEntry<'stops'>;
  Content: any;
}

const { stop, Content } = Astro.props;
const { title, category, time, link, addedBy } = stop.data;

const categoryEmoji: Record<string, string> = {
  food: '🍜',
  sight: '⛩️',
  activity: '🎌',
  stay: '🏨',
  travel: '🚄',
};
---

<article class="stop">
  <div class="stop-head">
    {time && <span class="time">{time}</span>}
    <span class="emoji" aria-hidden="true">{categoryEmoji[category]}</span>
    <h4>
      {link ? <a href={link}>{title}</a> : title}
    </h4>
  </div>
  <div class="stop-body">
    <Content />
  </div>
  {addedBy && <p class="meta hand">added by {addedBy}</p>}
</article>

<style>
  .stop {
    padding: 0.9rem 1rem;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) - 2px);
    background: var(--paper-raised);
    box-shadow: 0 2px 8px rgb(35 33 28 / 0.06);
  }

  .stop + .stop {
    margin-top: 0.75rem;
  }

  .stop-head {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .time {
    font-variant-numeric: tabular-nums;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    border-radius: 999px;
    padding: 0.05rem 0.5rem;
    white-space: nowrap;
    background: color-mix(in srgb, var(--accent) 7%, transparent);
  }

  h4 {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.4;
    font-family: var(--font-display);
    font-weight: 600;
  }

  .stop-body {
    font-size: 0.92rem;
    color: var(--ink-muted);
  }

  .stop-body :global(p) {
    margin: 0.35rem 0 0;
  }

  .meta {
    margin: 0.4rem 0 0;
    font-size: 0.88rem;
    color: var(--ink-muted);
  }

  .hand {
    font-family: var(--font-hand);
  }
</style>
