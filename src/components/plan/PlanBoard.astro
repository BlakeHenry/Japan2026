---
/**
 * The /overview/ planner: the committed plan seeded in, the island mounted on
 * top, and the design's visual language carried here rather than in Base.
 *
 * The CSS is `is:global` because island DOM sits outside Astro's style
 * scoping — the same reason FilterBar.astro carries the filter styles. It's
 * all namespaced under `.pl-` so it can't leak into the paper register that
 * the cover and /map/<city>/ still use.
 *
 * `client:load`, not `client:visible`: the timeline is the page, and it is
 * above the fold on every screen.
 */
import type { TripDoc } from '../../lib/plan/doc';
import type { SeededProposals } from '../../lib/plan/seed';
import PlanTimeline from './PlanTimeline';

interface Props {
  seed: TripDoc;
  proposals: SeededProposals;
}

const { seed, proposals } = Astro.props;
---

<div class="pl-surface">
  <PlanTimeline seed={seed} proposals={proposals} client:load />
</div>

<style is:global>
  /* The planner is its own register — a tool, not the scrapbook. It brings
     its own palette and type rather than inheriting Base's paper tokens, and
     everything is scoped under .pl- so the two never mix. */
  .pl-surface {
    --pl-ink: #171a21;
    --pl-ink-soft: #4c5364;
    --pl-ink-mute: #6d7484;
    --pl-ink-faint: #9aa1af;
    --pl-line: #e3e6ec;
    --pl-line-soft: #eceef3;
    --pl-edge: #ccd1db;
    --pl-raised: #fafbfd;
    --pl-field: #f2f3f6;
    --pl-accent: oklch(0.55 0.21 262);
    --pl-accent-deep: oklch(0.5 0.21 262);
    --pl-danger: #c03030;
    --pl-mono: 'Space Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    --pl-sans: 'Sora', ui-sans-serif, system-ui, sans-serif;
    /* One hatch for every pencilled thing — the timeline's travel bars and
       the compare rows draw the same cloth. */
    --pl-hatch-fill: repeating-linear-gradient(
      -45deg,
      rgba(26, 32, 48, 0.16) 0 6px,
      rgba(255, 255, 255, 0.2) 6px 12px
    );

    background: var(--pl-field);
    color: var(--pl-ink);
    font-family: var(--pl-sans);
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
  }

  .pl-surface *,
  .pl-surface *::before,
  .pl-surface *::after {
    box-sizing: border-box;
  }

  /* Base sets `h1, h2, h3 { font-family: var(--font-display) }` globally, and
     an element rule beats an inherited value — so without this the planner's
     headings come out in the paper register's EB Garamond. Restated on the
     classes rather than as `.pl-surface h1`, which would be (0,1,1) and would
     in turn beat the (0,1,0) `.pl-block-label` that wants the mono face. */
  .pl-title,
  .pl-pane-title {
    font-family: var(--pl-sans);
  }

  /* --- Header ------------------------------------------------------------ */

  .pl-head {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    padding: 24px 36px 14px;
    background: var(--pl-raised);
    border-bottom: 1px solid var(--pl-line-soft);
  }

  .pl-title {
    margin: 0;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .pl-title-wrap {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  /* The travel-time sum — under the schedule's name in PLAN and COMPARE. */
  .pl-total {
    font-family: var(--pl-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    color: var(--pl-ink-mute);
  }

  .pl-head-actions {
    margin-left: auto;
    display: flex;
    gap: 8px;
  }

  .pl-btn {
    font-family: var(--pl-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    color: #2a2f3a;
    background: #fff;
    border: 1px solid var(--pl-edge);
    border-radius: 8px;
    padding: 9px 16px;
    cursor: pointer;
  }

  .pl-btn:hover {
    border-color: var(--pl-accent);
    color: var(--pl-accent-deep);
  }

  .pl-btn-primary {
    border-color: var(--pl-accent);
    color: var(--pl-accent-deep);
    font-weight: 700;
  }

  .pl-btn-on {
    color: #fff;
    background: #3a4150;
    border-color: #3a4150;
  }

  .pl-btn-on:hover {
    color: #fff;
  }

  .pl-btn-danger {
    color: var(--pl-danger);
    border-color: #e3c4c4;
    font-weight: 700;
  }

  .pl-btn-danger:hover {
    background: #fdf2f2;
    border-color: #d43a3a;
    color: var(--pl-danger);
  }

  .pl-btn-sm {
    font-size: 9px;
    letter-spacing: 0.1em;
    padding: 6px 10px;
    border-radius: 7px;
  }

  /* PLAN | COMPARE — which face of the planner you're looking at. */
  .pl-mode {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border: 1px solid #dbdfe8;
    border-radius: 9px;
    background: #fff;
  }

  .pl-mode-btn {
    font-family: var(--pl-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    color: var(--pl-ink-mute);
    background: transparent;
    border: 0;
    border-radius: 6px;
    padding: 7px 14px;
    cursor: pointer;
  }

  .pl-mode-btn-on {
    color: #fff;
    background: #2a2f3a;
  }

  .pl-banner {
    margin: 0;
    padding: 12px 36px;
    background: #fff;
    border-bottom: 1px solid var(--pl-line);
    font-size: 13px;
    color: var(--pl-ink-soft);
  }

  .pl-banner ul {
    margin: 6px 0;
    padding-left: 18px;
  }

  .pl-link {
    font: inherit;
    color: var(--pl-accent-deep);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
  }

  /* --- Timeline ---------------------------------------------------------- */

  .pl-scroll {
    background: var(--pl-raised);
    border-bottom: 1px solid var(--pl-line);
    overflow-x: auto;
    padding: 16px 36px 22px;
  }

  .pl-track {
    position: relative;
  }

  .pl-days {
    position: relative;
    height: 44px;
  }

  /* Labels, not controls — the day rail has no interaction of its own. */
  .pl-day {
    position: absolute;
    top: 0;
    height: 44px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: 2px;
    padding: 0 0 0 8px;
    border-left: 1px solid var(--pl-line-soft);
  }

  .pl-day-wd {
    font-family: var(--pl-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
  }

  .pl-day-num {
    font-family: var(--pl-mono);
    font-size: 14px;
  }

  .pl-bars {
    position: relative;
    height: 64px;
    margin-top: 8px;
  }

  .pl-bar {
    position: absolute;
    top: 0;
    bottom: 0;
    border-radius: 12px;
    outline-offset: 2px;
    padding: 6px 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    touch-action: none;
  }

  .pl-bar-name {
    font-size: 13px;
    font-weight: 600;
    color: #1c2027;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pl-bar-input,
  .pl-branch-input {
    font-family: var(--pl-sans);
    font-weight: 600;
    color: #2a2f3a;
    background: #fff;
    border: 1px solid var(--pl-accent);
    border-radius: 6px;
    outline: none;
  }

  .pl-bar-input {
    font-size: 13px;
    padding: 2px 6px;
    width: 100%;
    max-width: 120px;
  }

  .pl-branch-input {
    font-size: 11px;
    padding: 1px 5px;
    width: 92px;
  }

  .pl-bar-del {
    position: absolute;
    top: 5px;
    right: 6px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #fff;
    border: 1px solid #d6dae2;
    color: #8a91a0;
    display: none;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    line-height: 1;
    cursor: pointer;
    padding: 0;
  }

  .pl-bar:hover .pl-bar-del {
    display: flex;
  }

  .pl-bar-del:hover {
    color: #d43a3a;
    border-color: #e3a3a3;
  }

  /* Pencilled, not booked — the same dashed/hatched language the paper pages
     use for anything nobody has committed to. */
  .pl-hatch {
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 2;
    pointer-events: none;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--pl-hatch-fill);
  }

  .pl-hatch-tag {
    font-family: var(--pl-mono);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #2a2f3a;
    background: rgba(255, 255, 255, 0.92);
    border-radius: 999px;
    padding: 3px 8px;
    box-shadow: 0 1px 3px rgba(20, 24, 35, 0.2);
  }

  /* The box reaches 28px ABOVE the bars, because the `+` lives up there and
     the handle's own mouseleave is what hides it — a button outside the box it
     is revealed by vanishes the moment you move towards it. The padding does
     the reaching: `align-items: center` centres the grip in the CONTENT box,
     so the grip stays on the bar while the hover region covers both. */
  .pl-handle {
    position: absolute;
    top: -28px;
    bottom: 0;
    padding-top: 28px;
    width: 20px;
    z-index: 30;
    cursor: ew-resize;
    display: flex;
    align-items: center;
    justify-content: center;
    touch-action: none;
  }

  .pl-handle-grip {
    width: 7px;
    height: 30px;
    border-radius: 4px;
    background: #fff;
    border: 1px solid #c8cdd8;
    box-shadow: 0 1px 3px rgba(20, 24, 35, 0.16);
  }

  .pl-handle-add,
  .pl-zone-add {
    position: absolute;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    cursor: pointer;
    padding: 0;
  }

  /* 4px into the handle's padding — absolute offsets are from the padding box,
     so this is the same place on screen it always was, now inside the hover
     region rather than 24px above it. */
  .pl-handle-add {
    top: 4px;
    width: 20px;
    height: 20px;
    background: var(--pl-accent);
    color: #fff;
    border: 0;
    font-size: 14px;
    box-shadow: 0 2px 6px rgba(40, 60, 200, 0.35);
  }

  .pl-branches {
    position: relative;
  }

  /* No z-index: a stacking context here would trap the + button at the
     zone's own layer, underneath the lane-0 pills. The zone is only a hover
     hit-strip, and as a positioned z-auto element it still paints below
     them — raising the zone itself instead would steal the pills' top-band
     hit-testing. */
  .pl-zone {
    position: absolute;
    top: 0;
    height: 30px;
  }

  /* Toward the top of the zone, above the pills (3) — a lane-0 pill centred
     on the same day would otherwise cover it. The editing travel pill and a
     dragged pill (inline z-index 30) still win. */
  .pl-zone-add {
    top: 2px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 4;
    width: 19px;
    height: 19px;
    background: #fff;
    border: 1.5px solid var(--pl-accent);
    color: var(--pl-accent-deep);
    font-size: 13px;
    box-shadow: 0 2px 5px rgba(20, 24, 35, 0.15);
  }

  /* Hit-test the pill, not the column: two unpinned trips share a cx, and
     the deeper lane's transparent column box — painted later at the same
     layer — would otherwise swallow the shallower pill's hover, clicks and
     its ×. Events from the pill still bubble to the column's own handlers. */
  .pl-branch {
    position: absolute;
    top: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    touch-action: none;
    transform: translateX(-50%);
    pointer-events: none;
  }

  .pl-branch .pl-branch-pill {
    pointer-events: auto;
    touch-action: none;
  }

  .pl-branch-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: 1.5px solid;
    flex: none;
    margin-top: -4px;
  }

  .pl-branch-line {
    flex: none;
  }

  .pl-branch-pill {
    /* Anchors the delete button to the pill, not the dot-and-line column. */
    position: relative;
    display: flex;
    align-items: center;
    padding: 5px 12px;
    border-radius: 999px;
    background: #fff;
    white-space: nowrap;
    outline-offset: 2px;
    font-size: 11px;
    font-weight: 600;
    color: #2a2f3a;
  }

  /* The track's own delete verb, so a compare row — which draws no pane —
     can still drop a day trip. Same grammar as .pl-bar-del. */
  .pl-branch-del {
    position: absolute;
    top: -7px;
    right: -7px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #fff;
    border: 1px solid #d6dae2;
    color: #8a91a0;
    display: none;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    line-height: 1;
    cursor: pointer;
    padding: 0;
  }

  .pl-branch:hover .pl-branch-del {
    display: flex;
  }

  .pl-branch-del:hover {
    color: #d43a3a;
    border-color: #e3a3a3;
  }

  /* Travel time to get to a stay — hangs at the stay's start boundary in the
     branches band, same grammar as a day-trip pill: dot, connector, pill.
     Neutral grey (a transition belongs to no city) and mono (it's a number);
     dashed is the register's word for "nobody has an estimate yet". */
  .pl-travel {
    position: absolute;
    top: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    transform: translateX(-50%);
    cursor: pointer;
    z-index: 3; /* over .pl-zone (auto), same layer as .pl-branch */
  }

  .pl-travel-pill {
    font-family: var(--pl-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
    color: var(--pl-ink-soft);
    background: #fff;
    border: 1px solid #dbdfe8;
    border-radius: 999px;
    padding: 4px 10px;
    white-space: nowrap;
    outline-offset: 2px;
  }

  .pl-travel-pill-off {
    border: 1.5px dashed #c8cdd8;
    color: var(--pl-ink-faint);
  }

  .pl-travel:hover .pl-travel-pill {
    border-color: var(--pl-accent);
    color: var(--pl-accent-deep);
  }

  /* The pill IS the editor — click it and it becomes this. Sized like the
     pill it replaces so the row doesn't jump, and mono like the number. */
  .pl-travel-input {
    font-family: var(--pl-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
    color: var(--pl-ink);
    background: #fff;
    border: 1px solid var(--pl-accent);
    border-radius: 999px;
    padding: 4px 10px;
    width: 78px;
    text-align: center;
    outline: none;
  }

  /* --- Compare ------------------------------------------------------------ */
  /* One row per proposed schedule, read-only; the name gutter is sticky so a
     row stays labelled while the day lane scrolls under it. Widths that the
     layout depends on (the 232px gutter) are mirrored in ComparePane.tsx. */

  .pl-cmp-scroll {
    overflow-x: auto;
    background: var(--pl-field);
    padding-bottom: 48px;
  }

  /* Shrink-wraps the widest row so every row's border reaches the same edge,
     while min-width keeps short content filling the viewport. */
  .pl-cmp-inner {
    display: inline-block;
    min-width: 100%;
  }

  .pl-cmp-head {
    display: flex;
    background: var(--pl-raised);
    border-bottom: 1px solid var(--pl-line);
  }

  .pl-cmp-gutter {
    position: sticky;
    left: 0;
    z-index: 6;
    width: 232px;
    flex: none;
    /* The row's own background rides along — a transparent sticky gutter
       would let the lane show through underneath it mid-scroll. */
    background: inherit;
    border-right: 1px solid var(--pl-line);
    border-left: 3px solid transparent;
    padding: 18px 18px 18px 33px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .pl-cmp-gutter-head {
    z-index: 9;
    background: var(--pl-raised);
    border-left: 0;
    padding: 16px 20px 12px 36px;
    flex-direction: row;
    align-items: flex-end;
  }

  .pl-cmp-count {
    font-family: var(--pl-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    color: var(--pl-ink-faint);
  }

  .pl-cmp-days {
    position: relative;
    height: 62px;
    flex: none;
  }

  .pl-cmp-day {
    position: absolute;
    bottom: 12px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-left: 8px;
    border-left: 1px solid #e8eaef;
  }

  .pl-cmp-day .pl-day-num {
    color: var(--pl-ink-soft);
  }

  .pl-cmp-row {
    display: flex;
    background: #fbfcfe;
    border-bottom: 1px solid #e8eaef;
  }

  .pl-cmp-row-on {
    background: #fff;
  }

  .pl-cmp-row-on > .pl-cmp-gutter {
    border-left-color: var(--pl-accent);
  }

  .pl-cmp-name-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .pl-cmp-name {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--pl-ink);
  }

  .pl-cmp-badge {
    font-family: var(--pl-mono);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: oklch(0.45 0.19 262);
    background: oklch(0.95 0.03 262);
    border-radius: 999px;
    padding: 3px 7px;
  }

  .pl-cmp-input {
    font-family: var(--pl-sans);
    font-size: 14px;
    font-weight: 700;
    color: var(--pl-ink);
    background: #fff;
    border: 1px solid var(--pl-accent);
    border-radius: 6px;
    padding: 2px 6px;
    width: 130px;
    outline: none;
  }

  .pl-cmp-acts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 2px;
  }

  /* Quieter than the stock button — deleting a proposal shouldn't out-shout
     making one the plan — but red once you reach for it. */
  .pl-cmp-del {
    color: #8a91a0;
    border-color: #dbdfe8;
  }

  .pl-cmp-del:hover {
    color: var(--pl-danger);
    border-color: #e3a3a3;
    background: #fff;
  }

  /* A lane hosts a full PlanTrack — the same editor PLAN zooms in on. The
     top padding (plus .pl-bars' own 8px margin) is the headroom the resize
     handles reach into: they extend 28px above the bars, and without this
     they'd poke into the row above. */
  .pl-cmp-lane {
    position: relative;
    flex: none;
    padding: 26px 0 8px;
  }

  /* No detail pane on this screen: the compare rows are for reading
     schedules against each other, so every edit they offer is one you make
     on the track itself. */

  .pl-cmp-foot {
    background: var(--pl-field);
    border-bottom: 0;
  }

  .pl-cmp-gutter-foot {
    border-right: 0;
    background: var(--pl-field);
    padding-left: 36px;
  }

  .pl-cmp-add {
    font-family: var(--pl-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--pl-accent-deep);
    background: #fff;
    border: 1.5px dashed oklch(0.72 0.11 262);
    border-radius: 9px;
    padding: 11px 14px;
    cursor: pointer;
    text-align: center;
    width: 100%;
  }

  .pl-cmp-add:hover {
    border-style: solid;
    background: oklch(0.97 0.02 262);
  }

  /* --- Below the fold ---------------------------------------------------- */

  .pl-below {
    padding: 32px 44px 64px;
  }

  .pl-pane {
    max-width: 640px;
  }

  .pl-pane-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .pl-swatch {
    width: 16px;
    height: 16px;
    border-radius: 5px;
    flex: none;
  }

  .pl-swatch-round {
    border-radius: 50%;
  }

  .pl-pane-title {
    margin: 0;
    font-size: 32px;
    font-weight: 700;
    letter-spacing: -0.03em;
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .pl-pane-ja {
    font-size: 18px;
    font-weight: 400;
    color: var(--pl-ink-faint);
  }

  .pl-pane-actions {
    display: flex;
    gap: 10px;
    margin-top: 28px;
    flex-wrap: wrap;
  }

  .pl-block {
    margin-top: 28px;
  }

  /* The row-label voice, same job as .sheet-label on the paper pages. */
  .pl-block-label {
    margin: 0;
    font-family: var(--pl-mono);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--pl-ink-faint);
  }

  .pl-empty {
    margin: 10px 0 0;
    font-size: 13px;
    color: var(--pl-ink-faint);
  }

  .pl-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }

  .pl-chip {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border: 1px solid var(--pl-line);
    border-radius: 10px;
    background: #fff;
    cursor: pointer;
    font: inherit;
  }

  .pl-chip:hover {
    border-color: oklch(0.7 0.12 262);
  }

  .pl-chip-name {
    font-size: 13px;
    font-weight: 600;
  }

  .pl-chip-tag {
    font-family: var(--pl-mono);
    font-size: 10px;
    color: var(--pl-accent-deep);
  }

  .pl-chip-tag-off {
    color: #a7adba;
  }


  @media (max-width: 700px) {
    .pl-head,
    .pl-banner,
    .pl-scroll,
    .pl-below {
