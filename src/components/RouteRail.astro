---
import { Image } from 'astro:assets';
import type { SegmentItinerary } from '../lib/itinerary';
import { citySlug, formatShort, formatStay } from '../lib/itinerary';
import { TRIP, TRIP_TITLE } from '../lib/trip';

interface Props {
  segments: SegmentItinerary[];
  /** "Oct 13 – Oct 27", from the trip window rather than from the segments */
  dateRange: string;
  /** Nights across the whole trip window */
  nights: number;
}

const { segments, dateRange, nights } = Astro.props;

// Cities and their day trips only — the travel between cities lives in each
// city's Transportation card, not on the rail (the dashed route thread is
// drawing, not data).
const stops = segments.map((si) => {
  const { city, cityJa, start, end, heroImage } = si.segment.data;
  return {
    id: citySlug(city),
    city,
    cityJa,
    heroImage,
    // Dates only — the per-city night count is on the section header, and
    // repeating it here just crowded the card.
    stay: formatStay(start, end),
    // Sub-entries hanging off this base's card — day trips happen *from*
    // the base.
    trips: si.dayTrips.map((dt) => ({
      slug: dt.slug,
      name: dt.trip.data.name,
      cityJa: dt.trip.data.cityJa,
    })),
  };
});

// The rail ends where the trip does. Home is a marker, not a destination
// with a panel, so it never joins `stops` (no anchor, no generated rules).
const homeDate = formatShort(TRIP.end);

// "You are here" without JS: :target lands on the <section>, and CSS can't
// hop from there to the matching rail card by itself. The set of cities is
// known at build time, so the rules are just written out — one per city.
// Specificity is (0,3,0) so it beats the scoped hover rule below regardless
// of where this tag lands. Each day trip gets a pair: full highlight on its
// own tag, plus a washed-out one on the parent's card — "you are here,
// roughly" — which never fights the parent's own rule because only one
// section is :target at a time.
const targetRules = stops
  .flatMap((s) => [
    `.plan-layout:has(#${s.id}:target) .route-card[href="#${s.id}"] .route-city{background:var(--highlight)}`,
    ...s.trips.flatMap((t) => [
      `.plan-layout:has(#${t.slug}:target) .subtrip[href="#${t.slug}"] .subtrip-name{background:var(--highlight)}`,
      `.plan-layout:has(#${t.slug}:target) .route-card[href="#${s.id}"] .route-city{background:color-mix(in srgb, var(--highlight) 45%, transparent)}`,
    ]),
  ])
  .join('');

// A hashless load shows the first city's panel (see the tab rules in
// plan.astro), so its card wears the highlight too — scoped to .segment
// targets so a stray in-page anchor doesn't strip it.
const defaultRule =
  stops.length > 0
    ? `.plan-layout:not(:has(.segment:target)) .route-card[href="#${stops[0].id}"] .route-city{background:var(--highlight)}`
    : '';
---

{/* The route, start to finish, as a column of taped photos. It's navigation,
    so it's plain anchors into the sections already on the page — no island,
    no selected-city state to keep in sync, and it works with JS off. */}
<aside class="route" aria-label="Trip route">
  <a class="back hand" href="/">← {TRIP_TITLE}</a>
  {/* No "The route" heading — the aside's aria-label already names the
      region, so the label was doing nothing a screen reader needed and
      nothing the photos didn't already say. */}
  <p class="route-range hand">
    {`${dateRange} · ${nights} ${nights === 1 ? 'night' : 'nights'}`}
  </p>

  <ol class="cards">
    {
      stops.map((s) => (
        <li>
          <a class="route-card" href={`#${s.id}`}>
            <span class="tape-strip" aria-hidden="true" />
            {/* A city can predate its photo; the card just goes photo-less,
                the same shape it always has on the mobile jump bar. */}
            {s.heroImage && (
              <span class="card-media">
                <Image
                  src={s.heroImage}
                  alt=""
                  widths={[320, 640]}
                  sizes="300px"
                  format="webp"
                  loading="lazy"
                  class="card-img"
                />
              </span>
            )}
            <span class="card-foot">
              <span class="route-city hand">
                {s.city}
                {s.cityJa && (
                  <span class="card-ja" lang="ja" aria-hidden="true">
                    {s.cityJa}
                  </span>
                )}
              </span>
              <span class="card-dates">{s.stay}</span>
            </span>
          </a>

          {s.trips.length > 0 && (
            <ul class="subtrips">
              {s.trips.map((t) => (
                <li>
                  <a class="subtrip" href={`#${t.slug}`}>
                    <span class="subtrip-branch" aria-hidden="true" />
                    <span class="subtrip-name">{t.name}</span>
                    {t.cityJa && (
                      <span class="subtrip-ja" lang="ja" aria-hidden="true">
                        {t.cityJa}
                      </span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
    <li>
      {/* End of the line, not a destination — there's no section to jump
          to, so no <a>: a dead anchor would snap the panel back to the
          first city via the :first-of-type fallback in plan.astro. */}
      <div class="route-card route-card-end">
        <span class="tape-strip" aria-hidden="true" />
        <span class="card-foot">
          <span class="route-city hand">Home</span>
          <span class="card-dates">{homeDate}</span>
        </span>
      </div>
    </li>
  </ol>
</aside>

<style is:inline set:html={targetRules + defaultRule}></style>

<style>
  .route {
    position: sticky;
    top: 0;
    align-self: start;
    max-height: 100svh;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    padding: 1.6rem 1.6rem 2.5rem 0;
    border-right: 1px dashed #d6cbae;
  }

  .back {
    font-size: 1.2rem;
    color: var(--ink-muted);
    text-decoration: none;
  }

  .route-range {
    margin: 0.7rem 0 1.4rem;
    font-size: 1.2rem;
    color: #8a8172;
  }

  .cards {
    margin: 0;
    padding: 0;
    list-style: none;
    /* Grid on purpose: the gap is the breathing room the departure legs used
       to provide, and the mobile block's `display: flex` overrides both
       declarations without needing a direction reset. */
    display: grid;
    gap: 2.75rem;
    position: relative;
    /* Where the route thread runs, and where the subtrip groups indent to —
       one value so the branch stubs always meet the line. */
    --spine-x: 1.9rem;
  }

  /* The route itself: one continuous dashed thread from Tokyo down to Home,
     drawn behind the whole column. Cards are opaque and full-width, so they
     paint over it and only the stretches between cards (and beside the
     day-trip tags) show. Top/bottom are clamped inside the first and last
     cards so no loose end pokes out. */
  .cards::before {
    content: '';
    position: absolute;
    left: var(--spine-x);
    top: 1.25rem;
    bottom: 1.25rem;
    border-left: 2px dashed #b0a68f;
  }

  .route-card {
    position: relative;
    display: block;
    background: #fff;
    padding: 0.5rem 0.5rem 0.35rem;
    box-shadow: 0 5px 12px rgb(60 50 30 / 0.14);
    text-decoration: none;
    color: inherit;
    rotate: -1.2deg;
    transition:
      rotate 0.16s ease,
      box-shadow 0.16s ease;
  }

  .cards li:nth-child(even) .route-card {
    rotate: 1.2deg;
  }

  /* Anchor-scoped so the inert Home card at the end gets no hover feedback —
     every navigating card is an <a>, the end marker is a <div>. */
  a.route-card:hover,
  a.route-card:focus-visible {
    color: inherit;
    rotate: 0deg;
    box-shadow: 0 10px 22px rgb(60 50 30 / 0.28);
  }

  .tape-strip {
    position: absolute;
    top: -9px;
    left: 50%;
    translate: -50% 0;
    width: 74px;
    height: 20px;
    background: rgb(233 212 150 / 0.85);
    rotate: -2deg;
    box-shadow: 0 1px 3px rgb(60 50 30 / 0.15);
  }

  .card-media {
    display: block;
    overflow: hidden;
    height: 86px;
  }

  .route-card :global(.card-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.35rem 0.15rem 0.1rem;
  }

  .route-city {
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.1;
    border-radius: 4px;
    padding: 0 0.25rem;
    margin-left: -0.25rem;
  }

  a.route-card:hover .route-city,
  a.route-card:focus-visible .route-city {
    background: var(--highlight);
  }

  .card-ja {
    font-family: var(--font-ja);
    font-weight: 400;
    font-size: 0.82rem;
    color: #a89264;
    margin-left: 0.3rem;
  }

  .card-dates {
    flex: none;
    font-weight: 600;
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8a8172;
  }

  /* Day trips hang off their base's card as smaller paper tags branching off
     the route thread (.cards::before), so "branches off this stop" reads
     without a label. The margin-left matches --spine-x so each tag's stub
     starts exactly on the line. */
  .subtrips {
    margin: 0.55rem 0 0 var(--spine-x);
    padding: 0.15rem 0 0.15rem 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .subtrip {
    display: inline-flex;
    align-items: baseline;
    text-decoration: none;
    color: inherit;
  }

  .subtrip-branch {
    flex: none;
    align-self: center;
    width: 0.8rem;
    border-top: 2px dashed #b0a68f;
    margin-right: 0.45rem;
  }

  .subtrip-name {
    background: var(--paper-raised);
    box-shadow: 0 3px 8px rgb(60 50 30 / 0.14);
    border-radius: 4px;
    padding: 0.25rem 0.65rem;
    font-size: 0.85rem;
    font-weight: 600;
    rotate: -0.4deg;
    transition:
      background 0.15s ease,
      rotate 0.15s ease;
  }

  .subtrips li:nth-child(even) .subtrip-name {
    rotate: 0.4deg;
  }

  .subtrip:hover .subtrip-name,
  .subtrip:focus-visible .subtrip-name {
    background: var(--highlight);
    rotate: 0deg;
  }

  .subtrip:hover {
    color: inherit;
  }

  .subtrip-ja {
    font-family: var(--font-ja);
    font-size: 0.72rem;
    color: #a89264;
    margin-left: 0.4rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .route-card,
    .subtrip-name {
      transition: none;
    }
  }

  /* Below the two-column breakpoint the rail stops being a rail: the photos
     would be a long preamble before the first city. What's left is the part
     scrolling can't replace — a jump bar. */
  @media (max-width: 900px) {
    .route {
      position: static;
      max-height: none;
      overflow: visible;
      padding: 1.4rem 0 0;
      border-right: 0;
    }

    .route-range {
      margin-bottom: 0.8rem;
    }

    .cards {
      display: flex;
      gap: 0.5rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      padding-bottom: 0.4rem;
    }

    /* No route thread in the jump bar — the pills' order carries the route. */
    .cards::before {
      content: none;
    }

    .cards::-webkit-scrollbar {
      display: none;
    }

    .cards > li {
      display: flex;
      align-items: stretch;
      gap: 0.5rem;
    }

    .route-card,
    .cards li:nth-child(even) .route-card {
      rotate: 0deg;
      padding: 0.35rem 0.7rem;
      white-space: nowrap;
    }

    .tape-strip,
    .card-media,
    .subtrip-branch {
      display: none;
    }

    /* In the jump bar the tags flatten into pills after their base. The
       dashed outline carries the "sub-location" reading that the spine did
       on desktop. */
    .subtrips {
      margin: 0;
      padding: 0;
      flex-direction: row;
      align-items: stretch;
      gap: 0.5rem;
    }

    .subtrips li {
      display: flex;
    }

    .subtrip {
      align-items: center;
      white-space: nowrap;
    }

    .subtrip-name,
    .subtrips li:nth-child(even) .subtrip-name {
      rotate: 0deg;
      white-space: nowrap;
      background: transparent;
      box-shadow: none;
      border: 1px dashed #b0a68f;
      padding: 0.3rem 0.7rem;
    }

    .card-foot {
      display: block;
      padding: 0;
    }

    .route-city {
      font-size: 1.15rem;
    }

    .card-dates {
      display: block;
      margin-top: 0.05rem;
    }
  }
</style>
