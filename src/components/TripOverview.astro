---
import type { TripCalendar } from '../lib/itinerary';
import { formatHours } from '../lib/itinerary';
import { travelEmoji } from '../lib/travel';

interface Props {
  calendar: TripCalendar;
  /** Positional accents, same indexing as the segments */
  accentFor: (index: number) => string;
}

const { calendar, accentFor } = Astro.props;
const { days, bands, cityBands, floats } = calendar;

// The one thing this row is for: how much of a day the travelling eats, and
// by what. A leg that crosses midnight prints its hours on the day it starts
// and a bare "→ ✈️" on the days it lands in, so every travel day is marked
// but the duration is stated once. Everything else about the leg — service,
// clock times, the full line — lives in the tooltip and the sr-only text.
const isContinuation = (role: string) => role === 'arrive' || role === 'via';

// Column 1 is the label rail; day i lives in column i + 2. Rows are fixed:
// 1 dates · 2 city · 3 sleeping · 4 travel · 5+ day trips.
const col = (i: number) => i + 2;
const FLOAT_ROW = 5;
---

{/* The whole trip as a labelled table — the spreadsheet view. One column per
    calendar day, one named row per kind of fact, the label rail sticky so
    the rows stay legible while the days scroll. Quiet days are drawn as
    nothing at all: the marks on the sheet are the things that happen. The
    only anchors are the city bands, lodging links, and the day-trip pills;
    day cells stay link-free so nothing nests.

    The bands and pills are same-page hashes, which makes this grid the page's
    navigation: each one selects its panel below. Which one is open is drawn
    by the :has() rules the page generates — see overview.astro. */}
<div class="sheet">
  <div class="grid" style={`--cols: ${days.length}`}>
    <span class="corner" aria-hidden="true"></span>
    {
      days.map((d, i) => (
        <span class="date" style={`grid-column: ${col(i)}`}>
          <span class="date-wd">{d.weekday}</span>
          <span class="date-num">{d.monthDay}</span>
        </span>
      ))
    }

    <span class="label label-band" style="grid-row: 2">City</span>
    {
      cityBands.map((b) =>
        b.kind === 'city' ? (
          <a
            class="band"
            href={`#${b.slug}`}
            style={`--band-accent: ${accentFor(b.segmentIndex!)}; grid-column: ${col(b.start)} / span ${b.span}`}
          >
            {b.label}
            {b.labelJa && (
              <span class="band-ja" lang="ja" aria-hidden="true">
                {b.labelJa}
              </span>
            )}
          </a>
        ) : (
          <span
            class="band band-ghost"
            style={`grid-column: ${col(b.start)} / span ${b.span}`}
          >
            <span aria-hidden="true">✈️</span>
            <span>{b.label}</span>
          </span>
        )
      )
    }

    <span class="rule" style="grid-row: 3" aria-hidden="true"></span>
    <span class="label" style="grid-row: 3">Sleeping</span>
    {
      bands.map((b) => (
        <span
          class="stay"
          style={`grid-column: ${col(b.start)} / span ${b.span}`}
        >
          {
            b.kind !== 'city' ? (
              <span class="stay-none">—</span>
            ) : b.lodging ? (
              b.lodging.link ? (
                <a
                  class="stay-name"
                  href={b.lodging.link}
                  target="_blank"
                  rel="noreferrer"
                  title={b.lodging.area}
                >
                  {b.lodging.name}
                </a>
              ) : (
                <span class="stay-name" title={b.lodging.area}>
                  {b.lodging.name}
                </span>
              )
            ) : (
              <span class="stay-none">Not booked</span>
            )
          }
        </span>
      ))
    }

    <span class="rule" style="grid-row: 4" aria-hidden="true"></span>
    <span class="label" style="grid-row: 4">Travel</span>
    {
      days.map((d, i) =>
        d.travel.length > 0 ? (
          <div class="travel" style={`grid-column: ${col(i)}`}>
            {d.travel.map((t) => (
              <span class="leg" title={t.text}>
                {/* The whole visible mark is decorative: the sr-only line
                    below says the same thing in full, and hearing "plane
                    16 hours" ahead of it just doubles the leg. */}
                <span class="leg-mark" aria-hidden="true">
                  {isContinuation(t.role) ? (
                    <Fragment>
                      <span class="leg-cont">→</span>
                      <span class="leg-mode">{travelEmoji(t.mode)}</span>
                    </Fragment>
                  ) : (
                    <Fragment>
                      <span class="leg-mode">{travelEmoji(t.mode)}</span>
                      {t.hours !== undefined && (
                        <span class="leg-hours">{formatHours(t.hours)}</span>
                      )}
                    </Fragment>
                  )}
                </span>
                <span class="sr-only">{t.text}</span>
              </span>
            ))}
          </div>
        ) : null
      )
    }

    {
      floats.length > 0 && (
        <Fragment>
          <span class="rule" style={`grid-row: ${FLOAT_ROW}`} aria-hidden="true" />
          <span class="label" style={`grid-row: ${FLOAT_ROW}`}>
            Day trips
          </span>
        </Fragment>
      )
    }
    {
      floats.map((f) => (
        <a
          class="float"
          href={`#${f.slug}`}
          style={`grid-column: ${col(f.start)} / span ${f.span}; grid-row: ${FLOAT_ROW + f.row}`}
        >
          <span aria-hidden="true">🎒</span> {f.name}
        </a>
      ))
    }
  </div>

  <p class="sheet-note">🎒 Day trips don't have a day picked yet</p>
</div>

<style>
  .sheet {
    background: var(--paper-raised);
    box-shadow: 0 6px 16px rgb(60 50 30 / 0.12);
    border-radius: 3px;
    padding: 1rem 1.2rem 1.1rem;
  }

  /* The grid scrolls sideways by itself when the columns run out of room —
     the page never scrolls horizontally. The grid container IS the scroll
     container: sticky grid items only engage against their own grid's
     scrollport, not a wrapper's. */
  .grid {
    --rail-w: 5.5rem;
    display: grid;
    grid-template-columns: var(--rail-w) repeat(var(--cols), minmax(3.9rem, 1fr));
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
  }

  /* The label rail — sticky so the row names survive horizontal scrolling.
     Each label's grid AREA spans the whole row: a sticky item can only
     slide within its containing block, and a one-column area leaves it no
     slack. The box itself stays rail-width and opaque, so day cells slide
     beneath it. */
  .label,
  .corner {
    grid-column: 1 / -1;
    position: sticky;
    left: 0;
    z-index: 2;
    width: var(--rail-w);
    box-sizing: border-box;
    background: var(--paper-raised);
    padding: 0.6rem 0.75rem 0.5rem 0;
    font-weight: 700;
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #b0a68f;
    border-top: 1px solid var(--border);
  }

  .corner,
  .label-band {
    border-top: 0;
  }

  .corner {
    grid-row: 1;
  }

  /* The row hairline across the day columns. The label carries its own
     matching border, so the line reads as continuous under the rail. */
  .rule {
    grid-column: 2 / -1;
    align-self: start;
    height: 0;
    border-top: 1px solid var(--border);
  }

  .date {
    grid-row: 1;
    display: flex;
    flex-direction: column;
    padding: 0.15rem 0.35rem 0.5rem;
  }

  .date-wd {
    font-weight: 700;
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .date-num {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    line-height: 1.1;
  }

  /* Row 2 — the city bands. Flat colour is the data here (which stay a day
     belongs to), so no tape and no tilt: a tinted strip with the accent as a
     left key, doubling as the link into that city's panel. */
  .band {
    grid-row: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4em;
    min-width: 0;
    margin: 0.15rem 2px;
    padding: 0.35rem 0.5rem;
    background: color-mix(in srgb, var(--band-accent) 20%, var(--paper-raised));
    border-left: 3px solid var(--band-accent);
    border-radius: 3px;
    font-weight: 800;
    font-size: 0.63rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: center;
    color: var(--ink);
    text-decoration: none;
    transition: background 0.15s ease;
  }

  a.band:hover,
  a.band:focus-visible {
    color: var(--ink);
    background: color-mix(in srgb, var(--band-accent) 34%, var(--paper-raised));
  }

  .band-ja {
    font-family: var(--font-ja);
    font-weight: 400;
    letter-spacing: normal;
    color: var(--ink-muted);
  }

  .band-ghost {
    flex-direction: column;
    gap: 0.05rem;
    background: transparent;
    border: 1px dashed #b0a68f;
    border-radius: 4px;
    padding: 0.3rem 0.25rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--ink-muted);
    overflow: hidden;
  }

  /* Row 3 — Sleeping. One cell per stay, spanning its days: the lodging
     name (linked when there's a booking page) or the honest empty state. */
  .stay {
    grid-row: 3;
    display: flex;
    align-items: baseline;
    min-width: 0;
    padding: 0.6rem 0.35rem 0.5rem;
  }

  .stay-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9rem;
    line-height: 1.25;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .stay-none {
    font-size: 0.72rem;
    color: #b0a68f;
  }

  /* Row 4 — Travel. Only days that hold a leg draw anything, and what they
     draw is one short mark: the mode glyph and how many hours the day gives
     up to it. One day's column is room enough for that, which is why the
     cell no longer spreads into the quiet days after it. */
  .travel {
    grid-row: 4;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
    padding: 0.6rem 0.35rem 0.5rem;
  }

  .leg {
    display: block;
    min-width: 0;
    /* Anchors the sr-only leg text — unanchored, its static position lands
       at page-root coordinates deep inside the scrolled grid and the page
       grows sideways scroll on mobile. */
    position: relative;
  }

  .leg-mark {
    display: flex;
    align-items: baseline;
    gap: 0.2em;
    min-width: 0;
  }

  .leg-mode {
    font-size: 0.85rem;
  }

  .leg-hours {
    font-weight: 700;
    font-size: 0.72rem;
    line-height: 1.3;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }

  /* The day a crossing lands on: same glyph, no hours — the duration was
     already stated on the day it started. */
  .leg-cont {
    font-size: 0.72rem;
    line-height: 1.3;
    color: #b0a68f;
  }

  /* Rows 5+ — undated day trips under their base's columns, wearing the
     dashed-outline pill that means sub-location. Anchors into their panels
     below. */
  .float {
    justify-self: center;
    align-self: start;
    min-width: 0;
    max-width: calc(100% - 0.7rem);
    margin: 0.6rem 0.35rem 0;
    border: 1px dashed #b0a68f;
    border-radius: 4px;
    padding: 0.25rem 0.7rem;
    font-size: 0.78rem;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--ink-muted);
    text-decoration: none;
    transition: background 0.15s ease;
  }

  a.float:hover,
  a.float:focus-visible {
    color: var(--ink);
    background: var(--highlight);
    border-color: transparent;
  }

  .sheet-note {
    margin: 1rem 0 0;
    font-size: 0.78rem;
    color: #8a8172;
  }

  @media (prefers-reduced-motion: reduce) {
    .band,
    .float {
      transition: none;
    }
  }
</style>
