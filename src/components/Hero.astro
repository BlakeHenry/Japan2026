---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { TRIP } from '../lib/trip';

interface Props {
  image: ImageMetadata;
  imageAlt: string;
  imageCaption: string;
  dateRange: string;
}

const { image, imageAlt, imageCaption, dateRange } = Astro.props;
---

{/* The cover page: exactly one viewport, no scrolling, no navigation except
    the tape button at the bottom. Everything here is sized against svh so the
    photo and the button can never push each other off screen. */}
<section class="hero">
  <p class="hero-kicker">{dateRange}</p>
  <h1>
    <span>{TRIP.name}</span>
    <span class="swash" data-size="lg">{TRIP.year}</span>
  </h1>
  <figure class="polaroid">
    <div class="polaroid-media">
      <Image
        src={image}
        alt={imageAlt}
        widths={[800, 1400, 2000]}
        sizes="(max-width: 768px) 92vw, 760px"
        format="webp"
        loading="eager"
        fetchpriority="high"
        class="hero-img"
      />
    </div>
    <figcaption class="hand">{imageCaption}</figcaption>
  </figure>
  <a class="hero-cta tape" href="/overview/">Open the plan →</a>
</section>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: min(3.25rem, 4svh) 1rem 0;
  }

  .hero-kicker {
    margin: 0;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    font-size: 0.8rem;
    color: var(--ink-muted);
  }

  h1 {
    margin: 0.15rem 0 0;
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    font-weight: 500;
    line-height: 1.18;
    /* Three-way min: the design's 92px ceiling, a 12svh term so the whole
       cover fits one screen on short laptops, and a 13vw term the mockup
       omits — at 92px "Japan 2026" in EB Garamond is far wider than a phone. */
    font-size: min(5.75rem, 12svh, 13vw);
  }

  /* The year is a solid rounded chip here, not the marker-pen blob .swash is
     everywhere else. Scoped rules are (0,2,0) and beat Base's (0,1,0), which
     is the documented way to tune a shared mark locally. em units so the chip
     tracks the fluid title size. */
  .swash[data-size='lg'] {
    padding: 0 0.26em;
    border-radius: 0.2em;
    rotate: 0deg;
    line-height: 1.18;
  }

  /* Taped-down photo. The width lives on the frame, not the photo, because
     the 1rem of white border is part of what has to fit the viewport — and
     because a shrink-to-fit flex item gives a percentage child nothing to
     resolve against. 792px = the design's 760px photo plus both borders. */
  .polaroid {
    position: relative;
    margin: 1.4rem 0 0;
    width: min(792px, 100%);
    background: #fff;
    padding: 1rem 1rem 0.625rem;
    box-shadow: 0 16px 36px rgb(60 50 30 / 0.18);
    rotate: -0.4deg;
  }

  .polaroid::before,
  .polaroid::after {
    content: '';
    position: absolute;
    top: -11px;
    width: 92px;
    height: 26px;
    background: rgb(233 212 150 / 0.85);
    box-shadow: 0 1px 3px rgb(60 50 30 / 0.15);
  }

  .polaroid::before {
    left: 64px;
    rotate: -3deg;
  }

  .polaroid::after {
    right: 64px;
    rotate: 3deg;
  }

  /* An explicit box rather than an aspect-ratio, so the photo is bounded by
     the viewport's height as well as its width and the cover always fits.
     the width comes from the frame's content box, already fitted above. */
  .polaroid-media {
    overflow: hidden;
    height: min(426px, 46svh);
  }

  /* Narrow screens crop portrait rather than letterbox — a 2:1 sliver above a
     bottom-anchored button leaves the middle of the page empty. */
  @media (max-width: 768px) {
    .polaroid-media {
      height: min(520px, 52svh);
    }
  }

  .polaroid :global(.hero-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  figcaption {
    margin-top: 0.55rem;
    text-align: center;
    font-size: 1.35rem;
    line-height: 1.2;
    color: #8a8172;
  }

  /* The look is the global .tape mark; this is the button-sized tune of it,
     plus a text-decoration reset because Base's global <a> rules would
     otherwise underline it and turn it red on hover. */
  .hero-cta {
    margin: auto 0 min(1.75rem, 3svh);
    flex: none;
    padding: 0.5rem 1.375rem;
    rotate: -1deg;
    font-size: 0.75rem;
    line-height: 1.4;
    letter-spacing: 0.18em;
    text-decoration: none;
    transition:
      rotate 0.18s ease,
      translate 0.18s ease;
  }

  .hero-cta:hover,
  .hero-cta:focus-visible {
    color: var(--tape-ink);
    rotate: 0deg;
    translate: 0 -2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-cta {
      transition: none;
    }
  }
</style>
