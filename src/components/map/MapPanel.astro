---
import MapSlot from './MapSlot';
import { CATEGORIES } from '../../lib/categories';
import type { MapPoint } from '../../lib/itinerary';
import '../../styles/map-paper.css';

interface Props {
  points: MapPoint[];
  segmentId: string;
  city: string;
  /** 'page' fills a full-viewport pane; the default sits in normal flow */
  variant?: 'panel' | 'page';
}

const { points, segmentId, city, variant } = Astro.props;

const glyphs = Object.fromEntries(CATEGORIES.map((c) => [c.key, c.emoji]));
---

{/* The live map island — the only thing on the site that loads Google. */}
<MapSlot
  client:visible
  points={points}
  segmentId={segmentId}
  city={city}
  glyphs={glyphs}
  variant={variant}
/>
