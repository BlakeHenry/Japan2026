---
import type { CollectionEntry } from 'astro:content';
import { filterGroup } from '../lib/categories';
import {
  formatShort,
  googleMapsUrl,
  stopDomId,
  stopSlug,
} from '../lib/itinerary';

interface Props {
  stop: CollectionEntry<'stops'>;
  Content: any;
}

const { stop, Content } = Astro.props;
const { title, category, link, date, time, lat, lng } = stop.data;

// One row = an optional date pill, a serif title, one handwritten line.
// Anything else the frontmatter knows stays off the screen.
//
// One target per row, and coordinates win: on the day, "where is it and how
// do I get there" beats "what are its opening hours", and a venue's own site
// is one tap away from Maps rather than the other way round.
const mapsUrl = lat != null && lng != null ? googleMapsUrl(lat, lng) : null;
const href = mapsUrl ?? link ?? null;
const destination = mapsUrl ? 'Google Maps' : 'their website';

// The row IS the anchor rather than containing one: an <a> inside an <a> is
// invalid, and the parser unnests it — which would hoist this element out
// from under #segmentId and silently break hover-sync and filtering.
const Tag = href ? 'a' : 'article';
const linkAttrs = href
  ? { href, target: '_blank', rel: 'noopener noreferrer' }
  : // MapSlot's jumpTo() focuses this element after scrolling to it. -1 keeps
    // that working without making a row that goes nowhere a tab stop.
    { tabindex: '-1' };

// The date pill only ever appears on /map/<city>/, which lists booked stops
// alongside ideas. The index passes `ideas` only, and those are undated by
// definition (buildItinerary partitions on data.date), so it's inert there.
---

<Tag
  class="idea"
  id={stopDomId(stop.id)}
  data-id={stopSlug(stop.id)}
  data-group={filterGroup(category)}
  data-dated={date ? 'true' : undefined}
  {...linkAttrs}
>
  <div class="idea-main">
    <h4 class="idea-title">
      {
        date && (
          <span class="idea-when">
            {formatShort(date)}
            {time && <b class="idea-time">{time}</b>}
          </span>
        )
      }
      {title}
    </h4>
    <div class="idea-body hand">
      <Content />
    </div>
  </div>
  {href && <span class="idea-go" aria-hidden="true">↗</span>}
  {href && <span class="sr-only">(opens {destination} in a new tab)</span>}
</Tag>

<style>
  /* A journal entry, not a UI card: no box, no border, no shadow. */
  .idea {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    padding: 0.5rem 0.35rem;
    /* Anchors the sr-only "opens in a new tab" text — unanchored it lands at
       page-root coordinates and grows the root's scrollable overflow. Same
       fix, same reason, as the overview grid's .leg. */
    position: relative;
    border-radius: 8px 8px 0 0;
    /* Bottom hairline on every row (ruled journal lines): a sibling
       combinator draws wrong lines in the two-column grid and when
       filters hide arbitrary rows. */
    border-bottom: 1px solid var(--border);
    /* The row is the link now. Without these the global <a> rules in
       Base.astro underline every word in it and repaint the whole row
       accent-red on hover. */
    color: inherit;
    text-decoration: none;
  }

  .idea:hover {
    color: inherit;
  }

  .idea[hidden] {
    display: none;
  }

  /* Pin↔row sync highlights any row; the hover wash is reserved for rows that
     actually go somewhere, so hover never promises a click that does nothing. */
  .idea[data-active='true'],
  a.idea:hover,
  a.idea:focus-visible {
    outline: none;
    background: color-mix(in srgb, var(--highlight) 14%, transparent);
  }

  .idea-main {
    min-width: 0;
    flex: 1;
  }

  .idea-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.05rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }

  /* Booked stops carry their slot inline, on the same highlighter blob the
     Scheduled block uses. Only /map/<city>/ ever renders these. */
  .idea-when {
    display: inline-block;
    margin-right: 0.4rem;
    vertical-align: 0.12em;
    font-family: var(--font);
    font-size: 0.7rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    background: var(--highlight);
    border-radius: 999px;
    padding: 0.05rem 0.45rem;
    rotate: -1.5deg;
    box-shadow: 0 1px 3px rgb(35 33 28 / 0.12);
  }

  .idea-time {
    margin-left: 0.3rem;
    color: var(--accent);
  }

  /* Margin notes in handwriting, clamped to one ruled line */
  /* Caveat sits small for its em box, so this runs larger than a sans note
     would at the same weight of emphasis. The single-line clamp means bigger
     type shows fewer words — readable and truncated beats cramped and whole. */
  .idea-body {
    font-size: 1.1rem;
    line-height: 1.35;
    color: var(--ink-muted);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    overflow: hidden;
  }

  .idea-body :global(p) {
    margin: 0.1rem 0 0;
  }

  /* Quiet at rest so twenty rows don't shout; the row's hover brings it up.
     Only rows that go somewhere get one. */
  .idea-go {
    flex: none;
    align-self: center;
    font-size: 0.8rem;
    line-height: 1;
    color: var(--ink-muted);
    opacity: 0.45;
    transition: opacity 0.14s ease;
  }

  .idea:hover .idea-go,
  .idea:focus-visible .idea-go {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .idea-go {
      transition: none;
    }
  }
</style>
