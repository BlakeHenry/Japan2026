---
import { Image } from 'astro:assets';
import type { SegmentItinerary } from '../lib/itinerary';
import { formatRange } from '../lib/itinerary';
import DayCard from './DayCard.astro';
import StopCard from './StopCard.astro';

interface Props {
  si: SegmentItinerary;
  accent: string;
  stopContent: Map<string, any>;
}

const { si, accent, stopContent } = Astro.props;
const { segment, days, pool } = si;
const { city, start, end, lodging, heroImage, heroAlt, tagline, cityJa } =
  segment.data;

const id = city.toLowerCase().replace(/\s+/g, '-');
const firstDay = days[0].tripDayNumber;
const lastDay = days[days.length - 1].tripDayNumber;
const nights = days.length;
---

<section class="segment" id={id} style={`--accent: ${accent}`}>
  <div class="segment-grid">
    <div class="panel-col">
      <aside class="panel">
        <figure class="polaroid">
          <div class="panel-media">
            <Image
              src={heroImage}
              alt={heroAlt}
              widths={[480, 800, 1200, 1600]}
              sizes="(max-width: 768px) 100vw, 340px"
              format="webp"
              loading="lazy"
              class="panel-img"
            />
          </div>
          {tagline && <figcaption class="hand">{tagline}</figcaption>}
        </figure>
        <div class="panel-text">
          {
            cityJa && (
              <span class="city-ja" lang="ja" aria-hidden="true">{cityJa}</span>
            )
          }
          <h2 class="panel-city">{city}</h2>
          <p class="panel-dates">
            <span class="dates-range">{formatRange(start, end)}</span><span
              class="dates-days"> · Days {firstDay}–{lastDay}</span>
          </p>
          <p class="panel-lodging">
            <span aria-hidden="true">🏨</span>
            {lodging.link ? <a href={lodging.link}>{lodging.name}</a> : lodging.name}
            <span class="nights">{nights} {nights === 1 ? 'night' : 'nights'}</span>
          </p>
        </div>
      </aside>
    </div>

    <div class="days-col">
      {days.map((day) => <DayCard day={day} stopContent={stopContent} />)}

      {
        pool.length > 0 && (
          <section class="pool">
            <h3>While in {city}</h3>
            <p class="pool-hint">Not tied to a day — slot in wherever they fit.</p>
            {pool.map((stop) => (
              <StopCard stop={stop} Content={stopContent.get(stop.id)} />
            ))}
          </section>
        )
      }

      <div class="segment-notes">
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .segment {
    --seg-bg: var(--paper);
    view-timeline: --seg block;
    padding: 4rem 1rem;
  }

  .segment:nth-of-type(even) {
    --seg-bg: color-mix(in srgb, var(--paper-raised) 65%, var(--paper));
    background: var(--seg-bg);
  }

  .segment-grid {
    max-width: 72rem;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 3.5rem;
  }

  /* .panel-col stretches to the full row height (default grid stretch),
     giving the sticky panel room to travel while the days scroll. */
  .panel {
    position: sticky;
    top: clamp(1rem, 4vh, 2.5rem);
  }

  .polaroid {
    position: relative;
    margin: 0;
    background: #fff;
    padding: 0.7rem 0.7rem 0.5rem;
    border: 1px solid var(--border);
    box-shadow: 0 8px 22px rgb(35 33 28 / 0.12);
    rotate: -1.4deg;
  }

  .segment:nth-of-type(even) .polaroid {
    rotate: 1.4deg;
  }

  .polaroid::before {
    content: '';
    position: absolute;
    top: -13px;
    left: 50%;
    translate: -50% 0;
    width: 92px;
    height: 28px;
    background: rgb(233 214 160 / 0.65);
    box-shadow: 0 1px 3px rgb(35 33 28 / 0.12);
    rotate: -3deg;
  }

  .panel-media {
    overflow: hidden;
    /* Panel (photo + text) must fit within the viewport for sticky pinning
       to feel right; keep the image squat enough on short screens. */
    aspect-ratio: 4 / 5;
    max-height: 46vh;
  }

  .panel :global(.panel-img) {
    width: 100%;
    height: 114%;
    object-fit: cover;
  }

  figcaption {
    margin-top: 0.4rem;
    font-size: 0.95rem;
    color: var(--ink-muted);
    text-align: center;
  }

  .hand {
    font-family: var(--font-hand);
  }

  .panel-text {
    padding-top: 1.2rem;
  }

  .panel-city {
    margin: 0;
    font-size: clamp(2rem, 4vw, 2.7rem);
    line-height: 1.1;
  }

  .city-ja {
    display: none; /* shown only in the mobile full-screen hero */
  }

  .panel-dates {
    margin: 0.3rem 0 0;
    font-weight: 600;
    color: var(--accent);
  }

  .panel-lodging {
    margin: 0.6rem 0 0;
    font-size: 0.95rem;
    color: var(--ink-muted);
  }

  .nights {
    margin-left: 0.5rem;
    font-size: 0.78rem;
    border: 1px solid var(--border);
    background: var(--paper-raised);
    border-radius: 999px;
    padding: 0.1rem 0.5rem;
    white-space: nowrap;
  }

  .days-col > :global(.day-card:first-child) {
    border-top: none;
    padding-top: 0;
  }

  .pool {
    margin-top: 1.5rem;
    padding: 1.25rem;
    border: 1.5px dashed color-mix(in srgb, var(--accent) 55%, var(--border));
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--highlight) 12%, transparent);
  }

  .pool h3 {
    margin: 0;
    font-size: 1.35rem;
  }

  .pool-hint {
    margin: 0.2rem 0 1rem;
    font-size: 0.85rem;
    color: var(--ink-muted);
  }

  .segment-notes {
    margin-top: 1.5rem;
    font-size: 0.95rem;
    color: var(--ink-muted);
  }

  .segment-notes :global(p) {
    margin: 0.4rem 0;
  }

  /* Scroll-driven parallax — evergreen browsers only; older ones get a
     clean static layout since sticky pinning needs no animation. */
  @supports (animation-timeline: view()) {
    .panel :global(.panel-img) {
      animation: pan linear both;
      animation-timeline: --seg;
      animation-range: cover 0% cover 100%;
    }

    .pool,
    .segment-notes {
      animation: rise linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 40%;
    }
  }

  @keyframes pan {
    from {
      translate: 0 0;
    }
    to {
      translate: 0 -12%;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel :global(.panel-img),
    .pool,
    .segment-notes {
      animation: none;
    }
  }

  @media (max-width: 768px) {
    .segment {
      padding: 0; /* hero is full-bleed; the days sheet re-adds gutters */
    }

    /* Single column; the wrapper column dissolves (display: contents) so the
       sticky hero's containing block is the full-height segment, letting it
       stay pinned while every day card scrolls past. */
    .segment-grid {
      display: block;
    }

    .panel-col {
      display: contents;
    }

    /* Full-screen pinned hero. svh (not dvh/vh) so iOS URL-bar collapse
       never reflows segment heights mid-scroll. */
    .panel {
      top: 0;
      z-index: 1; /* below the days sheet */
      height: 100vh;
      height: 100svh;
      overflow: hidden; /* clips the oversized kanji + panned image */
    }

    /* A giant polaroid taped to the paper: white frame with a thick bottom
       border, tape at the top, and a slight alternating tilt — the desktop
       vibe scaled up to fill the screen. */
    .polaroid {
      position: absolute;
      inset: 1.5rem 0.95rem 1.05rem;
      padding: 0.55rem 0.55rem 2.5rem;
      rotate: -1deg;
      box-shadow: 0 10px 26px rgb(35 33 28 / 0.2);
    }

    .segment:nth-of-type(even) .polaroid {
      rotate: 1deg;
    }

    .polaroid::before {
      width: 112px;
      height: 30px;
    }

    /* Tagline moves into the polaroid's bottom border, caption-style */
    .polaroid figcaption {
      position: absolute;
      left: 0.55rem;
      right: 0.55rem;
      bottom: 0.45rem;
      margin: 0;
      font-size: 0.85rem;
      line-height: 1.3;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .panel-media {
      position: relative;
      height: 100%;
      aspect-ratio: auto;
      max-height: none;
    }

    /* .panel-img keeps its base 114% height — the same pan headroom the
       desktop parallax uses now applies to the full-screen hero. */

    /* Legibility scrim: strong at the bottom (name/dates/lodging live
       there), a whisper at the top. Neutral dark ink rather than the
       per-city accent — accents can't be guaranteed to contrast on photos. */
    .panel-media::after {
      content: '';
      position: absolute;
      inset: 0;
      background:
        linear-gradient(
          to top,
          rgb(18 16 12 / 0.74),
          rgb(18 16 12 / 0.3) 34%,
          transparent 58%
        ),
        linear-gradient(to bottom, rgb(18 16 12 / 0.25), transparent 20%);
    }

    /* Overlay text block, anchored just above the polaroid's bottom border
       (photo bottom edge sits at 1.05rem inset + 2.5rem frame = 3.55rem) */
    .panel-text {
      position: absolute;
      z-index: 2;
      left: 2.1rem;
      right: 2.1rem;
      bottom: 4.4rem;
      padding: 0;
      min-width: 0;
    }

    /* Half-opaque brush kanji behind the city name. It's white, so where it
       runs past the photo onto the white frame it simply disappears — an
       automatic clip to the photo, no overflow handling needed. */
    .city-ja {
      display: block;
      position: absolute;
      z-index: 0;
      right: -0.5rem;
      bottom: 2.9rem;
      font-family: var(--font-brush);
      font-weight: 400;
      font-size: clamp(7rem, 34vw, 10.5rem);
      line-height: 1;
      white-space: nowrap;
      color: rgb(255 255 255 / 0.42);
      pointer-events: none;
    }

    /* Latin text sits above the kanji */
    .panel-city,
    .panel-dates,
    .panel-lodging {
      position: relative;
      z-index: 1;
    }

    .panel-city {
      font-size: clamp(2.6rem, 12vw, 3.6rem);
      font-weight: 700;
      line-height: 1.02;
      letter-spacing: -0.01em;
      color: #fff;
      text-shadow: 0 2px 18px rgb(0 0 0 / 0.45);
    }

    .panel-dates {
      margin-top: 0.35rem;
      font-size: 1rem;
      color: rgb(255 255 255 / 0.95);
      text-shadow: 0 1px 8px rgb(0 0 0 / 0.5);
    }

    .dates-days {
      display: none; /* the day-number range stays desktop-only */
    }

    .panel-lodging {
      margin-top: 0.45rem;
      font-size: 0.85rem;
      color: rgb(255 255 255 / 0.88);
      text-shadow: 0 1px 8px rgb(0 0 0 / 0.5);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .panel-lodging a {
      text-decoration-color: rgb(255 255 255 / 0.55);
    }

    .panel-lodging a:hover {
      color: #fff;
    }

    .nights {
      border-color: rgb(255 255 255 / 0.4);
      background: rgb(255 255 255 / 0.16);
      color: #fff;
    }

    /* Opaque paper sheet that rides up over the pinned hero */
    .days-col {
      position: relative;
      z-index: 2;
      margin-top: -1.25rem; /* rounded edge peeks over the photo bottom */
      padding: 1.5rem 1rem 2.5rem;
      border-radius: 22px 22px 0 0;
      background: var(--seg-bg);
      box-shadow: 0 -10px 26px rgb(35 33 28 / 0.28);
    }
  }
</style>
