---
import { Image } from 'astro:assets';
import type { SegmentItinerary } from '../lib/itinerary';
import { formatRange } from '../lib/itinerary';
import DayCard from './DayCard.astro';
import StopCard from './StopCard.astro';

interface Props {
  si: SegmentItinerary;
  accent: string;
  stopContent: Map<string, any>;
}

const { si, accent, stopContent } = Astro.props;
const { segment, days, pool } = si;
const { city, start, end, lodging, heroImage, heroAlt, tagline } = segment.data;

const id = city.toLowerCase().replace(/\s+/g, '-');
const firstDay = days[0].tripDayNumber;
const lastDay = days[days.length - 1].tripDayNumber;
const nights = days.length;
---

<section class="segment" id={id} style={`--accent: ${accent}`}>
  <div class="segment-grid">
    <div class="panel-col">
      <aside class="panel">
        <figure class="polaroid">
          <div class="panel-media">
            <Image
              src={heroImage}
              alt={heroAlt}
              widths={[480, 800, 1200]}
              sizes="(max-width: 768px) 76px, 340px"
              format="webp"
              loading="lazy"
              class="panel-img"
            />
          </div>
          {tagline && <figcaption class="hand">{tagline}</figcaption>}
        </figure>
        <div class="panel-text">
          <h2 class="panel-city">{city}</h2>
          <p class="panel-dates">
            {formatRange(start, end)} · Days {firstDay}–{lastDay}
          </p>
          <p class="panel-lodging">
            <span aria-hidden="true">🏨</span>
            {lodging.link ? <a href={lodging.link}>{lodging.name}</a> : lodging.name}
            <span class="nights">{nights} {nights === 1 ? 'night' : 'nights'}</span>
          </p>
        </div>
      </aside>
    </div>

    <div class="days-col">
      {days.map((day) => <DayCard day={day} stopContent={stopContent} />)}

      {
        pool.length > 0 && (
          <section class="pool">
            <h3>While in {city}</h3>
            <p class="pool-hint">Not tied to a day — slot in wherever they fit.</p>
            {pool.map((stop) => (
              <StopCard stop={stop} Content={stopContent.get(stop.id)} />
            ))}
          </section>
        )
      }

      <div class="segment-notes">
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .segment {
    view-timeline: --seg block;
    padding: 4rem 1rem;
  }

  .segment:nth-of-type(even) {
    background: color-mix(in srgb, var(--paper-raised) 65%, var(--paper));
  }

  .segment-grid {
    max-width: 72rem;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 3.5rem;
  }

  /* .panel-col stretches to the full row height (default grid stretch),
     giving the sticky panel room to travel while the days scroll. */
  .panel {
    position: sticky;
    top: clamp(1rem, 4vh, 2.5rem);
  }

  .polaroid {
    position: relative;
    margin: 0;
    background: #fff;
    padding: 0.7rem 0.7rem 0.5rem;
    border: 1px solid var(--border);
    box-shadow: 0 8px 22px rgb(35 33 28 / 0.12);
    rotate: -1.4deg;
  }

  .segment:nth-of-type(even) .polaroid {
    rotate: 1.4deg;
  }

  .polaroid::before {
    content: '';
    position: absolute;
    top: -13px;
    left: 50%;
    translate: -50% 0;
    width: 92px;
    height: 28px;
    background: rgb(233 214 160 / 0.65);
    box-shadow: 0 1px 3px rgb(35 33 28 / 0.12);
    rotate: -3deg;
  }

  .panel-media {
    overflow: hidden;
    /* Panel (photo + text) must fit within the viewport for sticky pinning
       to feel right; keep the image squat enough on short screens. */
    aspect-ratio: 4 / 5;
    max-height: 46vh;
  }

  .panel :global(.panel-img) {
    width: 100%;
    height: 114%;
    object-fit: cover;
  }

  figcaption {
    margin-top: 0.4rem;
    font-size: 0.95rem;
    color: var(--ink-muted);
    text-align: center;
  }

  .hand {
    font-family: var(--font-hand);
  }

  .panel-text {
    padding-top: 1.2rem;
  }

  .panel-city {
    margin: 0;
    font-size: clamp(2rem, 4vw, 2.7rem);
    line-height: 1.1;
  }

  .panel-dates {
    margin: 0.3rem 0 0;
    font-weight: 600;
    color: var(--accent);
  }

  .panel-lodging {
    margin: 0.6rem 0 0;
    font-size: 0.95rem;
    color: var(--ink-muted);
  }

  .nights {
    margin-left: 0.5rem;
    font-size: 0.78rem;
    border: 1px solid var(--border);
    background: var(--paper-raised);
    border-radius: 999px;
    padding: 0.1rem 0.5rem;
    white-space: nowrap;
  }

  .days-col > :global(.day-card:first-child) {
    border-top: none;
    padding-top: 0;
  }

  .pool {
    margin-top: 1.5rem;
    padding: 1.25rem;
    border: 1.5px dashed color-mix(in srgb, var(--accent) 55%, var(--border));
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--highlight) 12%, transparent);
  }

  .pool h3 {
    margin: 0;
    font-size: 1.35rem;
  }

  .pool-hint {
    margin: 0.2rem 0 1rem;
    font-size: 0.85rem;
    color: var(--ink-muted);
  }

  .segment-notes {
    margin-top: 1.5rem;
    font-size: 0.95rem;
    color: var(--ink-muted);
  }

  .segment-notes :global(p) {
    margin: 0.4rem 0;
  }

  /* Scroll-driven parallax — evergreen browsers only; older ones get a
     clean static layout since sticky pinning needs no animation. */
  @supports (animation-timeline: view()) {
    .panel :global(.panel-img) {
      animation: pan linear both;
      animation-timeline: --seg;
      animation-range: cover 0% cover 100%;
    }

    .pool,
    .segment-notes {
      animation: rise linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 40%;
    }
  }

  @keyframes pan {
    from {
      translate: 0 0;
    }
    to {
      translate: 0 -12%;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel :global(.panel-img),
    .pool,
    .segment-notes {
      animation: none;
    }
  }

  @media (max-width: 768px) {
    .segment {
      padding: 2.5rem 1rem;
    }

    /* Single column; the wrapper column dissolves (display: contents) so the
       sticky bar's containing block is the full-height segment, letting it
       stay pinned while every day card scrolls past. */
    .segment-grid {
      display: block;
    }

    .panel-col {
      display: contents;
    }

    /* Compact sticky header bar */
    .panel {
      top: 0.5rem;
      margin-bottom: 1.25rem;
      z-index: 2;
      display: flex;
      align-items: center;
      gap: 0.9rem;
      padding: 0.6rem 0.75rem;
      margin-inline: -0.5rem;
      border-radius: var(--radius);
      background: color-mix(in srgb, var(--paper) 88%, transparent);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid var(--border);
      box-shadow: 0 4px 14px rgb(35 33 28 / 0.08);
    }

    .polaroid {
      padding: 0;
      border: none;
      box-shadow: none;
      rotate: none;
      background: none;
      flex: 0 0 76px;
    }

    .segment:nth-of-type(even) .polaroid {
      rotate: none;
    }

    .polaroid::before {
      display: none;
    }

    .polaroid figcaption {
      display: none;
    }

    .panel-media {
      aspect-ratio: 1;
      max-height: none;
      border-radius: 8px;
      border: 1px solid var(--border);
    }

    .panel :global(.panel-img) {
      height: 100%;
      animation: none;
    }

    .panel-text {
      padding-top: 0;
      min-width: 0;
    }

    .panel-city {
      font-size: 1.35rem;
    }

    .panel-dates {
      font-size: 0.85rem;
      margin-top: 0.1rem;
    }

    .panel-lodging {
      font-size: 0.8rem;
      margin-top: 0.2rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }
</style>
