---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SegmentAreas from '../components/segment/SegmentAreas.astro';
import Footer from '../components/Footer.astro';
import { loadTrip } from '../lib/loadTrip';
import heroImage from '../assets/segments/hero.jpg';

const { itinerary, stopContent, segmentContent, dateRange, cities, accentFor } =
  await loadTrip();
---

<Base title="Japan 2026">
  <Hero
    image={heroImage}
    imageAlt="Chureito Pagoda overlooking Mount Fuji framed by autumn leaves"
    imageCaption="Chūreitō Pagoda & Fuji-san, autumn"
    dateRange={dateRange}
    cities={cities}
  />

  <main>
    {
      itinerary.segments.map((si, i) => {
        const Notes = segmentContent.get(si.segment.id)!;
        return (
          <SegmentAreas
            si={si}
            accent={accentFor(i)}
            index={i}
            stopContent={stopContent}
          >
            <Notes />
          </SegmentAreas>
        );
      })
    }
  </main>

  <Footer />
</Base>
