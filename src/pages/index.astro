---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { loadTrip } from '../lib/loadTrip';
import { TRIP_TITLE } from '../lib/trip';
import heroImage from '../assets/segments/hero.jpg';

const { dateRange } = await loadTrip();
---

{/* The cover: one screen, one photo, one way in. The itinerary itself lives
    at /overview/ — this page deliberately carries no cities, no footer, and
    nothing that scrolls. */}
<Base title={TRIP_TITLE}>
  <main>
    <Hero
      image={heroImage}
      imageAlt="Chureito Pagoda overlooking Mount Fuji framed by autumn leaves"
      imageCaption="Chūreitō Pagoda & Fuji-san, autumn"
      dateRange={dateRange}
    />
  </main>
</Base>
