---
import PlanBoard from '../components/plan/PlanBoard.astro';
import Base from '../layouts/Base.astro';
import { loadTrip } from '../lib/loadTrip';
import { seedDoc } from '../lib/plan/seed';
import { TRIP_TITLE } from '../lib/trip';

const { itinerary } = await loadTrip();

// The committed plan, serialized for the island. Everything after the first
// paint comes from localStorage; this is what a fresh browser sees, and what
// RESET goes back to.
const seed = seedDoc(itinerary);
---

{/* The plan, and the whole of it — a horizontal day timeline you can edit,
    with the selected stop's detail below. There is no backend (GitHub Pages),
    so edits live in localStorage and EXPORT downloads the regenerated content
    files to commit. Astro emits this as overview/index.html, so every link to
    it uses a trailing slash — without one GitHub Pages answers with a 301
    first. */}
<Base
  title={`The plan · ${TRIP_TITLE}`}
  description="Every day of the trip on one screen, editable, and exportable back into the repo."
>
  <Fragment slot="head">
    {/* The planner's two faces, requested only on this page: the cover and the
        map pages stay in the paper register and must not pay for them. Both
        are variable, so each family is one file. */}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&family=Space+Mono:wght@400;700&display=swap"
    />
  </Fragment>

  <a class="pl-home" href="/">← {TRIP_TITLE}</a>
  <PlanBoard seed={seed} />
</Base>

<style is:global>
  /* The planner owns the whole viewport, so the page can't keep Base's paper
     background showing around it. */
  body:has(.pl-surface) {
    margin: 0;
    background: #f2f3f6;
  }

  .pl-home {
    position: absolute;
    top: 10px;
    left: 36px;
    z-index: 5;
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: #6d7484;
  }

  .pl-home:hover {
    color: oklch(0.5 0.21 262);
  }

  @media (max-width: 700px) {
    .pl-home {
      left: 18px;
    }
  }
</style>
