---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import StopList from '../components/StopList.astro';
import TripOverview from '../components/TripOverview.astro';
import DayTripPanel from '../components/segment/DayTripPanel.astro';
import SegmentAreas from '../components/segment/SegmentAreas.astro';
import { buildTripCalendar } from '../lib/itinerary';
import { loadTrip } from '../lib/loadTrip';
import { TRIP, TRIP_TITLE } from '../lib/trip';

const {
  itinerary,
  stopContent,
  segmentContent,
  dayTripContent,
  dateRange,
  accentFor,
} = await loadTrip();

// Nights across the whole trip window, not the sum of the segments — the header
// describes the trip we're on, which is the same length whether or not every
// night of it has a city yet.
const tripNights = Math.round(
  (TRIP.end.getTime() - TRIP.start.getTime()) / 86_400_000
);

// The whole window flattened to one day-per-column table. Gated on segments
// existing — with none there's nothing to chart, and the empty state below
// owns the page instead.
const calendar =
  itinerary.segments.length > 0
    ? buildTripCalendar(itinerary, TRIP.start, TRIP.end)
    : null;

// "You are here", drawn on the grid. CSS can't hop from a targeted panel back
// up to the band that opened it, so the pairs are generated here — one rule per
// city, and a pair per day trip (its own pill lit, its base's band washed:
// "you are here, roughly"). Slugs are safe to interpolate raw: citySlug strips
// punctuation, and buildItinerary throws on a duplicate, so every one of these
// selectors is unique and combinator-free.
const SELECTED_BAND =
  'background:color-mix(in srgb, var(--band-accent) 42%, var(--paper-raised));box-shadow:inset 0 0 0 1px var(--band-accent)';
const NEARBY_BAND =
  'background:color-mix(in srgb, var(--band-accent) 30%, var(--paper-raised))';
const SELECTED_FLOAT =
  'color:var(--ink);background:var(--highlight);border-color:transparent';

const targetRules = itinerary.segments
  .flatMap((si) => [
    `.ov-layout:has(#${si.slug}:target) .band[href="#${si.slug}"]{${SELECTED_BAND}}`,
    ...si.dayTrips.flatMap((dt) => [
      `.ov-layout:has(#${dt.slug}:target) .float[href="#${dt.slug}"]{${SELECTED_FLOAT}}`,
      `.ov-layout:has(#${dt.slug}:target) .band[href="#${si.slug}"]{${NEARBY_BAND}}`,
    ]),
  ])
  .join('');

// The hashless load shows the first city's panel, so its band has to read as
// selected too — same rule, keyed on nothing being targeted.
const defaultRule =
  itinerary.segments.length > 0
    ? `.ov-layout:not(:has(.segment:target)) .band[href="#${itinerary.segments[0].slug}"]{${SELECTED_BAND}}`
    : '';
---

{/* The trip, whole. The grid on top is both the summary and the navigation —
    every city band and day-trip pill selects the panel below it — and the
    panel area holds one city at a time. The paper stays; the scrapbook
    dressing doesn't. Astro emits this as overview/index.html, so every link
    to it uses a trailing slash — without one GitHub Pages answers with a
    301 first. */}
<Base
  title={`The plan · ${TRIP_TITLE}`}
  description="Every day of the trip on one screen, and what we do with each city."
>
  <Fragment slot="head">
    <style is:inline set:html={targetRules + defaultRule}></style>
  </Fragment>

  <div class="ov-layout">
    {/* Row one, and deliberately not a <section> and not inside <main>: the
        hashless-load rule below matches the first <section> child of <main>,
        so anything sectioning above the panels would silently steal it. */}
    <div class="ov-top">
      <header class="ov-head">
        <a class="ov-back" href="/">← {TRIP_TITLE}</a>
        <h1>The plan</h1>
        <p class="ov-dates">{dateRange} · {tripNights} nights</p>
      </header>

      {
        calendar ? (
          <TripOverview calendar={calendar} accentFor={accentFor} />
        ) : (
          <p class="ov-empty">
            Two weeks in {TRIP.name}, and the calendar is still a blank page.
          </p>
        )
      }
    </div>

    <main>
      {
        /* Day-trip panels come right after their base and — via the flattened
           Fragment — stay direct children of <main>: the tab rules below match
           `main > .segment`, and the first child must remain a base city for
           the hashless-load `:first-of-type` rule. */
        itinerary.segments.map((si, i) => {
          const Notes = segmentContent.get(si.segment.id)!;
          return (
            <Fragment>
              <SegmentAreas si={si} accent={accentFor(i)} index={i}>
                <Notes />
              </SegmentAreas>
              {si.dayTrips.map((dt) => {
                const TripNotes = dayTripContent.get(dt.trip.id)!;
                return (
                  <DayTripPanel
                    dt={dt}
                    parentCity={si.segment.data.city}
                    accent={accentFor(i)}
                    alt={i % 2 === 1}
                  >
                    <TripNotes />
                  </DayTripPanel>
                );
              })}
            </Fragment>
          );
        })
      }

      {/* A stop whose `city` matches no segment, or whose `date` falls outside
          every stay, otherwise vanishes from the site with nothing but a build
          warning to say so. Surfacing them here means a typo is visible to
          whoever is reading the page, not just to whoever ran the build. Not a
          .segment, so it sits below whichever city is open rather than
          replacing it. */}
      {
        itinerary.unscheduled.length > 0 && (
          <section class="unscheduled" id="unscheduled">
            <h2>Not on the itinerary yet</h2>
            <p>These don't line up with a city or a date on the trip.</p>
            <StopList
              stops={itinerary.unscheduled}
              stopContent={stopContent}
              layout="grid"
            />
          </section>
        )
      }

      {/* Inside <main> because on desktop the page itself no longer scrolls
          (see the tab rules below) — out there it would be unreachable. In
          here it ends whichever panel is open, and in the no-:has() fallback
          it sits where it always did: after everything. */}
      <Footer />
    </main>
  </div>
</Base>

<style is:global>
  /* One city at a time, selected from the grid above. On desktop the page
     never scrolls: the grid keeps row one and the open city's panel scrolls
     by itself, the same frame the map pages use. It's all :target, so it
     works with JS off, /map/<city>/'s back links land on the right city, and
     Back/Forward walk the hash history through cities for free. Global
     because the rules have to reach SegmentShell's .segment across scoping.

     Everything is gated on :has() — ungated, a browser without it would drop
     only the "show the first city" rule and open to a blank panel. Gated,
     such browsers get the old design instead: the grid, then every city on
     one long scrolling page. Same support line the generated "you are here"
     rules in <head> already draw.

     :target scoped to .segment so that targeting anything else in <main>
     (#unscheduled, a stop id) falls back to showing the first city rather
     than hiding all of them. */
  @supports selector(main:has(.segment:target)) {
    .ov-layout > main > .segment {
      display: none;
    }

    .ov-layout > main > .segment:target {
      display: block;
    }

    .ov-layout > main:not(:has(.segment:target)) > .segment:first-of-type {
      display: block;
    }

    /* The lock is desktop-only. The grid is a third of a phone's viewport —
       pinning it there would leave the panel a letterbox — so below 900px the
       document scrolls normally and a band tap jump-scrolls to the panel it
       opened. Same locked-desktop / flowing-mobile switch the map page makes.

       When a hidden section becomes :target the browser applies styles before
       scrolling it into view inside <main>, and each section sits at the
       panel's top — so switching cities also resets the panel's scroll.
       html's smooth scroll-behavior only governs the root scroller, which up
       here no longer moves. */
    @media (min-width: 901px) {
      .ov-layout {
        display: grid;
        /* minmax(0, 1fr), not auto: an auto column would let the day grid's
           16 columns widen the page instead of scrolling inside itself. */
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: auto minmax(18rem, 1fr);
        height: 100svh;
      }

      /* min-height: 0 is load-bearing — without it a 1fr grid row refuses to
         shrink below its content and the panel never scrolls (same note as
         the map page's grid). The 18rem floor above is the other half: on a
         very short window the wrapper overflows 100svh and the root scrolls
         a little, rather than crushing the panel to nothing. */
      .ov-layout > main {
        min-height: 0;
        overflow-y: auto;
        overscroll-behavior: contain;
      }
    }
  }
</style>

<style>
  .ov-layout {
    max-width: 110rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .ov-top {
    padding: 0.9rem 0 1rem;
  }

  /* One line: back, title, dates. Every pixel spent here is a pixel the open
     panel doesn't get. */
  .ov-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0 0.9rem;
    margin-bottom: 0.8rem;
  }

  .ov-back {
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--ink-muted);
  }

  .ov-head h1 {
    margin: 0;
    font-size: 1.35rem;
    line-height: 1.2;
  }

  .ov-dates {
    margin: 0;
    font-size: 0.85rem;
    color: var(--ink-muted);
  }

  .ov-empty {
    margin: 3rem 0;
    font-size: 1.2rem;
    color: var(--ink-muted);
    text-align: center;
  }

  .unscheduled {
    padding: 2.5rem 0 3.5rem;
  }

  .unscheduled h2 {
    margin: 0;
    font-size: 1.35rem;
  }

  .unscheduled p {
    margin: 0.2rem 0 1rem;
    font-size: 0.9rem;
    color: var(--ink-muted);
  }

  @media (max-width: 900px) {
    .ov-layout {
      padding-inline: 1rem;
    }
  }
</style>
