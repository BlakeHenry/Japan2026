---
import Base from '../layouts/Base.astro';
import RouteRail from '../components/RouteRail.astro';
import SegmentAreas from '../components/segment/SegmentAreas.astro';
import DayTripPanel from '../components/segment/DayTripPanel.astro';
import StopList from '../components/StopList.astro';
import Footer from '../components/Footer.astro';
import { loadTrip } from '../lib/loadTrip';
import { TRIP, TRIP_TITLE } from '../lib/trip';

const {
  itinerary,
  stopContent,
  segmentContent,
  dayTripContent,
  dateRange,
  accentFor,
} = await loadTrip();

// Nights across the whole trip window, not the sum of the segments — the rail
// describes the trip we're on, which is the same length whether or not every
// night of it has a city yet.
const tripNights = Math.round(
  (TRIP.end.getTime() - TRIP.start.getTime()) / 86_400_000
);
---

{/* The itinerary proper. Astro emits this as plan/index.html, so every link
    to it uses a trailing slash — same reason SegmentAreas writes
    /map/<city>/: without one GitHub Pages answers with a 301 first. */}
<Base title={`The plan · ${TRIP_TITLE}`}>
  <div class="plan-layout">
    {
      itinerary.segments.length > 0 ? (
        <RouteRail
          segments={itinerary.segments}
          dateRange={dateRange}
          nights={tripNights}
        />
      ) : (
        /* No cities means no route to draw, and an empty rail would just be
           a dashed line down an empty column. The back link still has to
           live somewhere, so it falls back to a plain one. */
        <p class="lone-back">
          <a class="hand" href="/">
            ← {TRIP_TITLE}
          </a>
        </p>
      )
    }

    <main>
      {/* The visible headings here are the city names (h2). Without this the
          page would have no h1 at all — the site's only visible one lives on
          the cover. */}
      <h1 class="sr-only">The plan</h1>

      {
        itinerary.segments.length === 0 && (
          <section class="no-cities">
            <h2>No cities yet</h2>
            <p class="hand">
              Two weeks in {TRIP.name}, and the itinerary is still a blank page.
            </p>
          </section>
        )
      }

      {
        /* Day-trip panels come right after their base and — via the flattened
           Fragment — stay direct children of <main>: the tab rules below match
           `main > .segment`, and the first child must remain a base city for
           the hashless-load `:first-of-type` rule. */
        itinerary.segments.map((si, i) => {
          const Notes = segmentContent.get(si.segment.id)!;
          return (
            <Fragment>
              <SegmentAreas si={si} accent={accentFor(i)} index={i}>
                <Notes />
              </SegmentAreas>
              {si.dayTrips.map((dt) => {
                const TripNotes = dayTripContent.get(dt.trip.id)!;
                return (
                  <DayTripPanel
                    dt={dt}
                    parentCity={si.segment.data.city}
                    accent={accentFor(i)}
                    alt={i % 2 === 1}
                  >
                    <TripNotes />
                  </DayTripPanel>
                );
              })}
            </Fragment>
          );
        })
      }

      {/* A stop whose `city` matches no segment, or whose `date` falls outside
          every stay, otherwise vanishes from the site with nothing but a build
          warning to say so. Surfacing them here means a typo is visible to
          whoever is reading the page, not just to whoever ran the build. */}
      {
        itinerary.unscheduled.length > 0 && (
          <section class="unscheduled" id="unscheduled">
            <h2>Not on the itinerary yet</h2>
            <p class="hand">
              These don't line up with a city or a date on the trip.
            </p>
            <StopList
              stops={itinerary.unscheduled}
              stopContent={stopContent}
              layout="grid"
            />
          </section>
        )
      }

      {/* Inside <main> because the page itself no longer scrolls (see the
          tab rules below) — out there it would be unreachable. In here it
          ends whichever panel is open, and in the no-:has() fallback it
          sits where it always did: after everything. */}
      <Footer />
    </main>
  </div>
</Base>

<style is:global>
  /* One city at a time. The page never scrolls between cities — the rail is
     the only way to move — and the open city's panel scrolls by itself, the
     same frame the map pages use. It's all :target, so it works with JS off
     and keeps /map/<city>/'s back links landing on the right city; Back and
     Forward walk the hash history through cities for free. Global because
     the rules have to reach SegmentShell's .segment across scoping.

     Everything is gated on :has() — ungated, a browser without it would
     drop only the "show the first city" rule and open to a blank page.
     Gated, such browsers get the previous design instead: every city on
     one long scrolling page. Same support line the rail's "you are here"
     highlight already draws.

     :target scoped to .segment so that targeting anything else in <main>
     (#unscheduled, a stop id) falls back to showing the first city rather
     than hiding all of them. When a hidden section becomes :target the
     browser applies styles before scrolling it into view inside <main>,
     and each section sits at the panel's top — so switching cities also
     resets the panel's scroll. html's smooth scroll-behavior only governs
     the root scroller, which no longer moves. */
  @supports selector(main:has(.segment:target)) {
    .plan-layout {
      height: 100svh;
      grid-template-rows: minmax(0, 1fr);
    }

    /* min-height: 0 is load-bearing — without it a 1fr grid row refuses to
       shrink below its content and the panel never scrolls (same note as
       the map page's grid). */
    .plan-layout > main {
      min-height: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    .plan-layout > main > .segment {
      display: none;
    }

    .plan-layout > main > .segment:target {
      display: block;
    }

    .plan-layout > main:not(:has(.segment:target)) > .segment:first-of-type {
      display: block;
    }

    /* The jump bar keeps row one to itself so it's always reachable; the
       open city scrolls in the row below. 100svh keeps the URL-bar chrome
       honest. */
    @media (max-width: 900px) {
      .plan-layout {
        grid-template-rows: auto minmax(0, 1fr);
      }
    }
  }
</style>

<style>
  /* The rail is a column of the page, not an overlay, so it scrolls its own
     content and the sections keep the full width of theirs. */
  .plan-layout {
    display: grid;
    grid-template-columns: 20rem minmax(0, 1fr);
    gap: 0 2.5rem;
    max-width: 96rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  main {
    min-width: 0;
  }

  .lone-back {
    margin: 1.6rem 0 0;
    font-size: 1.2rem;
  }

  .lone-back a {
    color: var(--ink-muted);
    text-decoration: none;
  }

  .no-cities {
    padding: 5rem 0 6rem;
    text-align: center;
  }

  .no-cities h1 {
    margin: 0;
    font-weight: 500;
    font-size: clamp(2rem, 5vw, 2.8rem);
  }

  .no-cities p {
    margin: 0.3rem 0 0;
    font-size: 1.35rem;
    color: var(--ink-muted);
  }

  .unscheduled {
    padding: 3rem 0 4rem;
  }

  .unscheduled h2 {
    margin: 0;
    font-size: 1.6rem;
  }

  .unscheduled p {
    margin: 0.2rem 0 1rem;
    font-size: 1.25rem;
    color: var(--ink-muted);
  }

  @media (max-width: 900px) {
    .plan-layout {
      grid-template-columns: minmax(0, 1fr);
      padding-inline: 1rem;
    }
  }
</style>
